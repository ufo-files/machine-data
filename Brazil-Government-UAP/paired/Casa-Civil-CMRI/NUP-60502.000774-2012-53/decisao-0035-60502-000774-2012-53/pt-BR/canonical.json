            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
          "page_id": "page-75b3573dbc313169261f02e6",
          "segment_id": "seg-125147af2605c4cc6c10f485",
          "segment_index": 5,
          "start_ms": null,
          "text": "5.      PROVIDÊNCIAS\nÀ Secretario-Executiva da CRMI poro cientificação do recorrente, da Controlodorio-Gerol do\nUnião - CGUe do Comando da Aeronáutico da presente decisão.",
          "text_sha256": "d49700ebf2d0ac255c4dd976a3b0f72c49b3a16287bd2ea047ca362bdc4642ad"
        },
