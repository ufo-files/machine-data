          "segment_index": 1,
          "start_ms": null,
          "text": "3.     ANÁLISE DO MÉRITO",
          "text_sha256": "988f2c03cf29f481c48a521d1fb75494b5046ea5cb7b8d8a96013f34c487b5d7"
        },
        {
          "end_ms": null,
