          "text": "Témoignages: MORLAAS (64) 29.11.2021",
          "text_sha256": "06ad16411744b8a37398c192e7866ec0ee37d94e91c0952bf50a5defb4490dec"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
