          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of several semi-circular and circular formations in the cloudy sky: condensation trails from military aerial maneuvers.",
          "translation_text_sha256": "80100ec5b1bce18044bc795d5ed187846b816f3f88d0fc35adafc228422c82bb"
        },
        {
          "end_ms": null,
