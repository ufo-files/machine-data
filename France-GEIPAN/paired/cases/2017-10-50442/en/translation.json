          "source_text_sha256": "21396e30ceb83035090e9df1b6e7a5a4b38c04c2364e3e6fc421768507f3cab7",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Very brief observation by a witness flying a drone of a bright \"flash\" type phenomenon; recording of a similar phenomenon by the drone's camera: Insufficient information.",
