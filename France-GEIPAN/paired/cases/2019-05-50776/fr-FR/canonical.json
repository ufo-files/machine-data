          "text": "Témoignages: ARRONNES (03) 31.05.2019",
          "text_sha256": "9507dabc80beb83b3086b1ce084a479456d67f963f395381ffd61b2f0da7297d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
