          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of the slow passage from west to east of a white bright point in the deep sky: mistaken for the ISS (International Space Station).",
          "translation_text_sha256": "52946226543664ff63eb02c99d573f438417e84de138eecab355d48b7cdc6bee"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-8e972b325daa90a713d01642",
          "qa_findings": [
            {
