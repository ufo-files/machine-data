        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-ba99c9b4b69fef6b27ac0338",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-09ed3f7313f3219a2bce47a6",
          "segment_index": 13,
          "source_segment_id": "seg-09ed3f7313f3219a2bce47a6",
          "source_text_sha256": "9bee928e9fa4b2a553c59148482372b893f3f6118e4b9b9ef08f1fa69a317c3a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: The witness makes a night time excursion in the small village of BRION (71) on July 9, 2016. Around 11:15 PM, their attention is drawn to a white flash that just occurred near the constellation of the Great Bear. Highly observant, the witness immediately memorizes the location of the appearance, which only lasts a second, and places it between the stars Merah and Dubhe. The witness then thinks of a star explosion (Nova or Supernova). They then consider that it cannot be an Iridium flash because the sudden and powerful flash intrigues them greatly. No other testimonies are collected. The sudden and powerful flash characterizes the oddness of the observation. Using the provided elements, the favored hypothesis of a reflection of the sun on an object orbiting Earth is retained (see the investigation report). Checks using the JSatTrack software conclude to a misidentification with the satellite ENVISAT given its position in the sky that evening, even near the location where the flash was seen by the witness. The GEIPAN classifies the case as A: misidentification with the satellite ENVISAT.",
          "translation_text_sha256": "52dc29d25c41ae74fcdb2f119d5a8f8a2c05e5d7f603b1604bf6a3b4dec142be"
        }
