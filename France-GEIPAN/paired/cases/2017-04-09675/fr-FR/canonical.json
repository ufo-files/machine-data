          "text": "Témoignages: AMBERIEU-EN-BUGEY (01) 22.04.2017",
          "text_sha256": "cd697c9e049cd41f81bf2a05d42271a0649a3dbda80483fb6b0d205c9fbaf372"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
