          "start_ms": null,
          "text": "Témoignages: PLERIN (22) 31.12.1994 T1 PLERIN (22) 31.12.1994 T2",
          "text_sha256": "b338f62e3073fa44675c34eacc312aa4fd0ba21d06bae0295cb7627210655525"
        },
        {
          "end_ms": null,
