          "text": "Témoignages: AMIENS (80) 06.08.2016",
          "text_sha256": "b6331bbbb78c5e134f636d7bbd4637b25f5f648dae4101bfea5f777d2415950d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
