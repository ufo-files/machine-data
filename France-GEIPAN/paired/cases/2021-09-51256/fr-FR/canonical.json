          "text": "Témoignages: ANTHON (38) 22.09.2021",
          "text_sha256": "456d0349fb29bc4ea5f18c2c1ddbaafdeff1389fac0fc1d43f6e6b2f331b99b7"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
