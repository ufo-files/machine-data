          "segment_id": "seg-1b6f9f6f01d0b826c4df4c17",
          "segment_index": 12,
          "source_segment_id": "seg-1b6f9f6f01d0b826c4df4c17",
          "source_text_sha256": "c155bfd9d9c2eb3cd0464ec191f85fc1f3c15d221de974cb7b1aa3573631afba",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent movement of a dozen white points in the early morning sky: likely observation of birds.",
