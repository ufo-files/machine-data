          "text": "Témoignages: MOULINS (03) 29.08.2015",
          "text_sha256": "f9ee6b1b6fc44a4b051bf37ee3fd8e7a4f903fdb4e3c3d03ac4331c07ef65bdb"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
