          "text": "Témoignages: MOUGINS (06) 08.08.2015",
          "text_sha256": "ea8de9cb14faf806cd9fd0326df786e6a75d8d5e954f9fd9f52d1dfbdf4c02ed"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
