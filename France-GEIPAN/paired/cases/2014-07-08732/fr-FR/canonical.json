          "text": "Témoignages: SAINT-LAURENT-LE-MINIER (30) 08.07.2014",
          "text_sha256": "be3fcbfff780c5604481aafe75b482bab5c44f102a43d85520823f647ca00d0d"
        },
        {
          "end_ms": null,
