          "source_text_sha256": "14e54038fd2b124657002ede432b23a6f7d1c9f96fca378cd6162b3d05e24f5b",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: A motorist observed red and white glowing points in the night sky: probable observation of a military aircraft for the PAN visually observed and reflections of lights from the car's interior for the PAN in the video.",
