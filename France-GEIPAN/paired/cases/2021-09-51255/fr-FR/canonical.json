          "text": "Témoignages: GROSLAY (95) 03.09.2021",
          "text_sha256": "f9d85985dea42d7105029e7e10f4f485a6f3fad6d466132f50332e964be04e58"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
