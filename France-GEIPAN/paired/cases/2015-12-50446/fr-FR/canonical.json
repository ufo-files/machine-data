          "text": "Témoignages: MULHOUSE (68) 18.12.2015",
          "text_sha256": "f6b2af539584fd9614131a3e84df90e1f6a3c38de076e22824e3da9d1c2e98d4"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
