          "source_text_sha256": "181866ac0f50ad94bcb6631a657301c6882e9f2439b8dfdda8269de7fe5c81f8",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: An automobilist observed a white glowing ball moving and stopping in a clear, starry sky: observation of Jupiter and an illusion of the \"following ball\".",
