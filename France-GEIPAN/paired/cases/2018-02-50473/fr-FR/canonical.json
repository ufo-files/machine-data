          "text": "Témoignages: [D73] de MARLY (59) vers MARESCHES (59) 25.02.2018",
          "text_sha256": "311513d9cab11a98b35ec131ac05cb129daa2141585ceca5e8b598377eb1eb34"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
