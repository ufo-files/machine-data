          "text": "Témoignages: PLESSIS-BELLEVILLE (LE) (60) 26.02.2023",
          "text_sha256": "e0f6346b4bb574638abb5bf50e0644cb88bb3db5ce445b30a25b53d64c0e2b06"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
