          "source_text_sha256": "c36aac65235c2818edc8eeb8e77d1ebbb7030346a8e528c4f13aab70d7c7ca07",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage of a bright point in the sky with variable intensity: satellite reflection phenomenon involving the former satellite Cosmos 2268.",
          "translation_text_sha256": "07a569b09b3cd47156e938e1c1dde23d73c083e643b8e9842830890f0af3b89b"
        },
        {
