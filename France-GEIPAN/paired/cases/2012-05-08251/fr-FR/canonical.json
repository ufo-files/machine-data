          "text": "Témoignages: VILLENEUVE-LES-AVIGNON (30) 18.05.2012",
          "text_sha256": "0081022b1f4ce4ed0d35f248830218ac233cd89ba8cb649bc565157e056f644a"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
