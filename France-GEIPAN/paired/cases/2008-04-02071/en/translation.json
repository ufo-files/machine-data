          "source_text_sha256": "b9d7b28e3e180e5e4a87d8adfca169fea5696935ba2bb964cabc78b7cd06ec5a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a bright white point in the sky with an apparent irregular trajectory: observation of the passage of the International Space Station.",
          "translation_text_sha256": "78eee4ab1d935711574e74dcf27848723672987caaa15c7044ff7db9194aeace"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-3adeddc39f8d10c24271fc67",
