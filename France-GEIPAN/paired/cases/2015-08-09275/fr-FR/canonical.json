          "text": "Témoignages: EVRY (91) 07.08.2015",
          "text_sha256": "f6583e721119bf394ff2578e302150911cad46419435d160cef103490405891a"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
