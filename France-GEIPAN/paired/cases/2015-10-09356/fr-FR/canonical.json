          "segment_index": 11,
          "start_ms": null,
          "text": "Témoignages: EYGALIERES (13) 24.10.2015 T1 EYGALIERES (13) 24.10.2015 T2",
          "text_sha256": "54754ee103f930434373fc8932dbc334b13284b435d4e7b6d468d16240608598"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
