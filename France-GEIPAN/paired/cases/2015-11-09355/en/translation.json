          "source_text_sha256": "5876e3bf69a53ae0f05193e1333c9e5ee623d861de4d5df9506357e2bdcd6b6d",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long night observation of a colored, flickering, and stationary light phenomenon in an overcast sky: probable observation of the star Sirius.",
