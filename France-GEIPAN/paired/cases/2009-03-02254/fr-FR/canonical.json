          "start_ms": null,
          "text": "Résumé: Observation du déplacement d'une boule blanche.",
          "text_sha256": "dd2f95d9cf435c1f8afd9a76bfc03edd53c5862670cf0f7d86080f1ac22c65cd"
        },
        {
          "end_ms": null,
