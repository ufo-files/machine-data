          "text": "Témoignages: AUTUN (71) 22.08.2014",
          "text_sha256": "55bc536a1585acb548b9d7e77ba9dc1dfcb6972453be31c4fff2092374727ba3"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
