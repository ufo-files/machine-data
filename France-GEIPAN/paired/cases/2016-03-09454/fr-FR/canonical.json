          "text": "Témoignages: PEYRUIS (04) 20.03.2016",
          "text_sha256": "722918271c0670a646ee57ec12e6d13323ba53542dc917c21341569fac851874"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
