          "start_ms": null,
          "text": "Résumé: Observation du passage rapide d'une forme triangulaire.",
          "text_sha256": "09e59f359a32ee1fad27d941cedcf7d5ba87210b391cbad632fa2b6250aefd79"
        },
        {
          "end_ms": null,
