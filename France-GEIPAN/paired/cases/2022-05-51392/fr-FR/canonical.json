          "start_ms": null,
          "text": "Témoignages: SAINT-CLAIR-DU-RHONE (38) 14.05.2022",
          "text_sha256": "60825ba77aebab60e0cf4e7292ad240ab24bf10959fe3df408c3f24f216c63e6"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
