          "text": "Témoignages: FRONTIGNAN (34) 02.09.2022 Temoin PHOTO PAN 1.jpeg",
          "text_sha256": "b6700ccbce930d8bc44160d633945932bf8db89f5f1ce30f3e98cc0251866853"
        },
        {
          "end_ms": null,
