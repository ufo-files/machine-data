          "text": "Témoignages: CHATENAY-MALABRY (92) 19.08.2012",
          "text_sha256": "48cd5666274def4a975814a0acab04d5a0b611cbd0cef809c1d2665275163280"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
