          "segment_index": 12,
          "source_segment_id": "seg-fb72b6451e95fc85434428c5",
          "source_text_sha256": "7e403b6e784c9f13393ce8dc252b8e684341581f129cc468bbfb40f57fe3f71c",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of the movements of a luminous object of color above the sea: observation of a fantasy balloon of \"Mylar\" type.",
