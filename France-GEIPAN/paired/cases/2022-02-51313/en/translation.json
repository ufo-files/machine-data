          "source_text_sha256": "4197f3c88891d085ed4920b8c9500fd974c7416d9ef0b8ec9504620d82035f0e",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation in the sky of the passage of a luminous phenomenon of color on a descending trajectory and then the constatation of a reddish trail: probable observation of a bolide.",
