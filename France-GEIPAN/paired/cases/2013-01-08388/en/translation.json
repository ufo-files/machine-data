        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-81d2b459e8dcb98041cd75a1",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-968ddf406b7885cc44497bb8",
          "segment_index": 12,
          "source_segment_id": "seg-968ddf406b7885cc44497bb8",
          "source_text_sha256": "da32109185f7acc5879d54b43c282cb629f49d3b7e655d55aec4623e146a92db",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: The witness on a chairlift (Bauge slope) notices at the zenith, the slow movement in the sky of an object shaped like a cigar of matte gray color following a straight trajectory from north to south. This same observation is made twice and during a 30-minute period. No other testimony is collected. We have here two observations made in half an hour and under strictly identical conditions. The presence of a commercial airliner could correspond to the overall observation for two major reasons:\n\n1. The witness states he did not see this airplane, even though it was perfectly within his field of vision.\n2. The description matches in every way: shape, color, movement. However, the second observation could not be characterized. If we refer to the witness's hourly data, the Airbus A-320 had logically passed, and could not have been in the same location as the previous one; it may be a second plane, perhaps military (so not tracked by Flightradar24) on the same air route. After investigation, based on the collected elements, movements on the ground, the witness's testimony, and the search for other witnesses through the press, this case is classified B: probable observations of airplanes.",
          "translation_text_sha256": "3b9638cd0fb5e24e8baabd12f9b72fe4c8bd13583f9e868a1dcd6a173a9942db"
        }
      ],
