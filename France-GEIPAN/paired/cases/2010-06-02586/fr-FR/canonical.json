          "text": "Résumé: Observations du déplacement de lanternes thailandaises.",
          "text_sha256": "b04b31e8a262f1fb222f5fee196da77871ceac7f96fd028810f0605f5308414f"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.914,
