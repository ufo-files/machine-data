          "segment_id": "seg-eff31930ba25a4ede4941c3f",
          "segment_index": 12,
          "source_segment_id": "seg-eff31930ba25a4ede4941c3f",
          "source_text_sha256": "2f28f9a99a96c23315ad521bfecca712aec1edd8d7d31176fbbc118e11a14a32",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of a colored light point in the night sky: probable observation of the star Capella.",
