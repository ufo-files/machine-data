          "text": "Témoignages: PENNAUTIER (11) 20.10.1990",
          "text_sha256": "ce8e245927ba4e31c4a8a8fbce4464f2470e3f27aaef3c306ac005ef49bdb7ba"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
