          "text": "Témoignages: ANTRAN (86) 29.08.2024",
          "text_sha256": "77f8b6068d7a7cb2c16747a457d299f2e7d03acef869f625acab11f326a5e147"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
