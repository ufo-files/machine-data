          "text": "Résumé: OBSERVATION D'UN OBJET CHANGEANT DE FORME.DISPARITION SOUDAINE.",
          "text_sha256": "cd6b86c7104fd72842d7431dac5c32ec008c3a512ffc32284fddd487f6fa1836"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.938,
