          "source_text_sha256": "d19219c21e109dbad215b9f7e6e6baadbbab817444f734e8f31d6780e05d1a6a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a straight-line, silent movement of an orange-colored light point in the sky: probable observation of a Thai lantern.",
