          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Sequential observations of the passage of a variable brightness white point in the deep sky: mistaken for the Telkom 3 satellite.",
          "translation_text_sha256": "900586e6bbe752912497f9a3aed27fdaac7aab143baf6460ea9687dfb07c9e70"
