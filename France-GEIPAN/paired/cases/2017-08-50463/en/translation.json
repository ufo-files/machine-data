        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-b172caaccbfa81cd58384559",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-fba909c349c4c7242f074b04",
          "segment_index": 13,
          "source_segment_id": "seg-fba909c349c4c7242f074b04",
          "source_text_sha256": "22fb12642ec1f9743eb7ecb18fb033a398b19b646a78226e3bb82c1f1c1fdb88",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: On August 21, 2017, and for several consecutive nights, a witness observes in the sky a bright white light with variable brightness. The object maintains a consistent general trajectory but slightly shifts over the course of the nights. Due to its relatively low strangeness and good consistency (multiple witnesses, but a unique and precise report, videos of PAN), the case turns out to be a misidentification with the Telkom 3 satellite. (See the investigation report). The witness's description strongly suggests a satellite rotating rapidly on itself, which is confirmed by the videos of PAN. However, the search for the satellite responsible for the misidentification needed to match several specific criteria: passing vertically over the witness on August 21, 2017, on a trajectory oriented from Northwest to Southeast, while passing to the left of the star Altair, between 9:10 PM and 9:25 PM, and then repeatedly passing on the same trajectory, shifting slightly towards the West, at the same time each night. Only one satellite matches these criteria, namely Telkom 3, an Indonesian satellite launched by a Russian rocket that failed in 2012 and known for its bright and somewhat irregular flashes. The case is classified as A, misidentification with the Telkom 3 satellite.",
          "translation_text_sha256": "6dbd544f565da70cdd92190a59f132fdba9e3c3c295735dd169fee483dadc961"
        }
      ],
