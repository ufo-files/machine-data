          "text": "Témoignages: [AERO] de MARSEILLE (13) vers TUNIS (TUN) 27.04.2025",
          "text_sha256": "82e091bda6ff003f3f7383f3058ce6dc6fe89ed98b1aee7fc481621aa3f16f86"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
