          "source_text_sha256": "8f903979cb7e5501d97f9cfb13999ded52c1c5e34a7ec0792cb944d7c9cdb097",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation from a ULM by two witnesses of the rapid movement of a blue-reflected sphere: probable observation of a mylar balloon.",
          "translation_text_sha256": "b71907a67a2b1a2d7fd976863a9c692589f64681909fcca09872a9e2d36214d7"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-5e252f8602aa44a6fcc07f68",
          "qa_findings": [
            {
              "added_in_translation": [],
