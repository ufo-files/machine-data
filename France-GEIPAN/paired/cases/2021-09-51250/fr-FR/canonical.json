          "text": "Témoignages: ORGON (13) 04.09.2021",
          "text_sha256": "b5138055a57891da8a294d8d5e6fb1595ccc3088c2137ad5ecb55da2a9534159"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
