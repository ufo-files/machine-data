          "text": "Témoignages: COUERON (44) 03.07.2015",
          "text_sha256": "0ef08e33335c4c2bfdee5bcae2ad66e7b1c9debdeffb7841fa96cd86bf046a2f"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
