          "start_ms": null,
          "text": "Résumé: Observation de 2 objets lumineux.",
          "text_sha256": "8f69df045512533dbe27eb85c67c2d225a4accd194faa585f28d211d94873a2d"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.81,
