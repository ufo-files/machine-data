          "source_text_sha256": "fe672af260ed0b89ad75998a5c53a6ede32f5648a1405f90c8db609bced60b83",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of the presence of two dark shapes in the clear sky, one of which seems to be circling around the other: balloon observation.",
