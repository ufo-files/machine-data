          "text": "Témoignages: SAUVIGNY (55) 20.10.2015",
          "text_sha256": "566f4a33af8394a7fff25e4fe10f14f4ed821b941a7b7b9392d29a316682c62f"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
