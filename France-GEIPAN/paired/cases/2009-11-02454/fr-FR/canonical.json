          "text": "Témoignages: CLAIRA (66) 09.11.2009",
          "text_sha256": "63f8fcbca696566cf02ab007de908ab869450cbc2fceeecf0f303ca7c2feba9e"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
