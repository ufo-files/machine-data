        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-963f4caf7d3f5693e94988f0",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-ea248add22657aed55af23dc",
          "segment_index": 13,
          "source_segment_id": "seg-ea248add22657aed55af23dc",
          "source_text_sha256": "ad6cd390158c616d6372073063ed1fcefb5327c2072cacc6e251028c9de47543",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: On December 29 at 6:30 PM, a witness is intrigued by a white disk in a descending trajectory in the sky. He takes a photograph and asks for explanations from the GEIPAN. After checks on the photograph to establish the precise time of capture and the characterization of the bright points appearing in the sky, it appears that: - the photo was taken around 6:05 PM, - what the witness identifies as a \"star\" in the photo is a \"hot\" or \"dead\" pixel on the camera sensor, which consistently appears at the position 1774 and 883 (very \"pixelated\", fluorescent green, and notably present at the same position in subsequent photos (see document:  DSC_0003_photo_test_pixel.jpg). What the witness refers to as \"and that?\" while pointing to a bright point near the horizon is indeed the planet Venus (at that time, no other star than Venus was visible, maybe Mars). The GEIPAN classifies this case as \"A\": observation of the planet Venus.",
          "translation_text_sha256": "a31bcb06fcb0abbb023aa1851e09a5bb2d4bca763cdde00d3170e3b101146111"
        }
      ],
