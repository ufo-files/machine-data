          "source_text_sha256": "fc7c59ec69bf3ed2a437d2627961da6755ef84baa13925d47f6b5b974df8b8b6",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a bright white disk in descending trajectory: observation of the planet Venus.",
