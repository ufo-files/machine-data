          "start_ms": null,
          "text": "Témoignages: AUTHEZAT (63) 04.07.2012",
          "text_sha256": "b8c5cf7a3337223a75bb72056d03298b77d42682551dfda5bce38aaa5da42836"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
