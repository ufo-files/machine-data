          "source_text_sha256": "8feee806e344a351917a3031305905accdca55fea65bdc1ac7d68d409fe284fb",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of a very bright fixed object to the left of the Moon: astronomical misidentification with Jupiter.",
          "translation_text_sha256": "023f81ddb63fe0a2e728a9c56be54438467057b4258060cb3473e34a9cbcd536"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-7060cc22a73aea69cd4ce7e4",
          "qa_findings": [
