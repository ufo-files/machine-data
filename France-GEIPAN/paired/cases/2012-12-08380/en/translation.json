          "source_segment_id": "seg-d792a20ae78a9fc1f5756a8c",
          "source_text_sha256": "8388a65e38dcbb7b222a7d30aa1e7c2666b454b4f1bfa794f98ef95da5438c14",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of silent, straight, and ascending movement of reddish-orange light phenomena; instantaneou extinction of some: probable observation of Thai lanterns.",
          "translation_text_sha256": "1465b94800b4a79d4358c79742c8a8a7dc6f8556a0d03190dc5ee5aaec4fe713"
