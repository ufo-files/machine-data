          "text": "Témoignages: NOISY-LE-SEC (93) 07.11.2016",
          "text_sha256": "4b52896756b8c236d6dd80c097afe2dc474d8a58329a422901c0260257e6a12f"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
