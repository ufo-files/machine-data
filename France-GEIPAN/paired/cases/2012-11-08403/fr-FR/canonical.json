          "text": "Témoignages: DOUARNENEZ (29) 18.11.2012",
          "text_sha256": "8cc118f10846b96ea4f8377dc59d4fd1e029ed5f120356379bbd7adc6dcd89ff"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
