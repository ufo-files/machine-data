          "text": "Témoignages: METZ (57) 18.09.2019",
          "text_sha256": "5426ddce68fe95b63fc2c37257dd7b4f713ac6d75b06493aa6e01e50f9442bbf"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
