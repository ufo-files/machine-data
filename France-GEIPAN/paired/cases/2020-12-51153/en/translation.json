          "source_text_sha256": "b24f79e18346a82839b34625f6f9e4c1cbbf77d4ba171ffd0ab668c7201789c4",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: A brief daytime observation of a very bright, round phenomenon silently crossing the sky: observation of a bolide in a clear daytime sky.",
