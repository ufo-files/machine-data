          "text": "Témoignages: LOURMARIN (84) 23.07.2021",
          "text_sha256": "de9a04d53c674b1e0fb90a3bd88963e5d511d75a869b924c22d08a487a60fd8f"
        },
        {
          "end_ms": null,
