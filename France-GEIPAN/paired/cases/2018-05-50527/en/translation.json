          "segment_index": 12,
          "source_segment_id": "seg-10837425e00fe847286c49fc",
          "source_text_sha256": "25575c67947212bc80e1cfd92f579c29aeea2cf820d9402cd7b3ac74ed5f5795",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a fixed light with effects of movement and color changes: very probable observation of Jupiter.",
