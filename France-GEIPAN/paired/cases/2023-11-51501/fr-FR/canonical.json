          "text": "Témoignages: [AERO] de MONASTIR (TN.99351) vers ORLY (94) 06.11.2023",
          "text_sha256": "1519189c4bc992808d2f7c99a004f3c32b1b1cbe7ba4d41e98861e32075470c0"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
