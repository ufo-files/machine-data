          "start_ms": null,
          "text": "Témoignages: THORIGNE-D'ANJOU (49) 15.08.2012 T1 THORIGNE-D'ANJOU (49) 15.08.2012 T2 THORIGNE-D'ANJOU (49) 15.08.2012 T3",
          "text_sha256": "b156fca7afe77efe29ca7facb1094c959fd3611501584500cfaaf593f259b5f8"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
