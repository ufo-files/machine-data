          "segment_index": 9,
          "start_ms": null,
          "text": "Résumé: Observation de 3 objets triangulaires ou pyramidaux survolant la voiture du témoin à basse altitude",
          "text_sha256": "035afdb52254f43bc9c26ff25cf311168203a9ac7c89faf5dddf970327f064b1"
        },
        {
          "end_ms": null,
