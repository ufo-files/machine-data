          "text": "Témoignages: BOUEXIERE (LA) (35) 08.10.2018",
          "text_sha256": "3883a8837279552a46a4748b9a25028bf5e37c3c69ea61d3c76a463909abd79e"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
