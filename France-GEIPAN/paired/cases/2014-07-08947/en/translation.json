          "source_text_sha256": "b7704579ba23af5051328fb60e763774e90da3cc420964dd15331d71e8f50e1a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of white lights in the sky: satellite observation.",
