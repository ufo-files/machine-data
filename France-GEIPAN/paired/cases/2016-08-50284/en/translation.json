          "source_segment_id": "seg-d2f5be856bec0ce5f62737fc",
          "source_text_sha256": "931b3ce6cf070da059928c5a46adea204a3d41f52f4f4d5aa77d71926e7122be",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the rapid and silent passage of a luminous phenomenon of color composed of 5 lights in V: probable misperception with a fragmented meteor.",
          "translation_text_sha256": "552ef4d9aa02d398f4e4ab7567c42916e76bdc494975ffa85f123a15748c0365"
