          "segment_id": "seg-04b74e9d565eb06dcf763cc9",
          "segment_index": 12,
          "source_segment_id": "seg-04b74e9d565eb06dcf763cc9",
          "source_text_sha256": "9819bd571942a9a673ab4a1652f743db35e1791da6ea921ec399b78820ea9ce2",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Two witnesses briefly observed a bright phenomenon moving across the night sky; likely a meteor.",
