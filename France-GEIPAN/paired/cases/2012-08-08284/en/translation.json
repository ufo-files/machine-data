          "source_text_sha256": "e684fc15c59515b771e188218b873733c156bb5d75aec935c5ef20c4e04148cd",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent and straight passage of a flying object in the shape of a weaver's shuttle: strange unidentified phenomenon.",
          "translation_text_sha256": "326d748b9ab5757bf9deede9a05a0e04dad15b1c491be5d39a4bcdd4e2bde272"
