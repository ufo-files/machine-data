          "text": "Témoignages: [D2] de SAINT-ANDEOL-LE-CHATEAU (69) vers GIVORS (69) 07.12.2017",
          "text_sha256": "4fa333a295ad4a600092a94e8ed11b13b36c0abfe4ebb58daf77a6efe7ea4f88"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
