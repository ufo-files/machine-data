          "source_text_sha256": "f45451b1fcc12cf7ec2203f836e8408556c721ad754813c845e8f442fcee3861",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation from a moving vehicle and through a smartphone of a small circular green fluorescent patch in the landscape: photographic artifact.",
