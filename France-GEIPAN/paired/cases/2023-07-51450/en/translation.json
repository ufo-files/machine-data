          "source_text_sha256": "bb0725384bf204ea33ea0de6cd976474b818186090de44d7893b52e6af025fdf",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation early in the morning of a PAN resembling \"some sort of slow explosion\": observation of the Moon under particular conditions.",
