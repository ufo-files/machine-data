          "source_text_sha256": "a698a754748a99d40338b5ca0ae102a1d0aedf5610eebb446b9b5444d00ce98a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of silent movements of white balls in the cloudy sky: probable observation of laser impacts.",
