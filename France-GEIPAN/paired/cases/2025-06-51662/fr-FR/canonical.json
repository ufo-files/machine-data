          "text": "Témoignages: PARIS (75) 22.06.2025",
          "text_sha256": "b2f4348f48f78b8b0421baea3e64a19a0276bb08e8b01e9cda3b43359c1f101d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
