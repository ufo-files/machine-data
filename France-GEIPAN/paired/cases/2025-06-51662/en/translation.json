          "source_text_sha256": "b0cdd0f85c7e05f538d0bdce1f8b65241b6269705adf66b148c83e8739f5cc6d",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a dark and mobile PAN with a peculiar trajectory in the Paris sky: observation of one or more balloons carried by the wind.",
