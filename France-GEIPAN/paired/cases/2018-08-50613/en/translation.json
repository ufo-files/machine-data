          "segment_id": "seg-90c2c366c1e42b403e2b4035",
          "segment_index": 12,
          "source_segment_id": "seg-90c2c366c1e42b403e2b4035",
          "source_text_sha256": "87e5924654b86a6d37f2fd7e771169d6031b04aab57cc2929fa2531680d7d75f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation and photography of a bright light in the sky followed by extinction: misidentification with an airplane.",
