          "text": "Témoignages: MAISONS-ALFORT (94) 22.04.2015",
          "text_sha256": "e432536769d143c557ecfac329baa91edd7877a29dbc9877033ea90613b9ac45"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
