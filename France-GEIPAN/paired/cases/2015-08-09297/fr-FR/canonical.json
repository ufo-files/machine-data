          "text": "Témoignages: ENTRE-DEUX (974) 21.08.2015",
          "text_sha256": "4b3a861d5a1a1593b349327c360f5af8e59f56496bc3a86c8a7141e25c83b7a4"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.875,
