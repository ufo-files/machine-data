          "source_text_sha256": "2c388b4c408f01c3d6d3ff552b91d157e3cceb6c0f79a3fb5f25893b7787bd25",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation during a fair of the movement of a dark object below the cloud layer: probable observation of the movement of a helium-filled party balloon.",
          "translation_text_sha256": "ad9d68d33d69478b4980353227fb512add89c9bb30f54364358903fed3881a53"
        },
        {
