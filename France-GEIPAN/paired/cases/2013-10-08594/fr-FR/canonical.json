          "text": "Témoignages: COLLOBRIERES (83) 27.10.2013",
          "text_sha256": "1af74c6c89e55cdbd81c901b31a04c64c9b04b90e1a848b0971d53e2d0f911ac"
        },
        {
          "end_ms": null,
