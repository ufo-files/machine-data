          "source_text_sha256": "ef3a625f9f374d2669af02fac2979c8b3e4f1b56bc530d125944efee33b06137",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of the fall of a bright, round object with green streaks: atmospheric reentry of a meteoroid.",
