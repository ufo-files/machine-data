          "text": "Témoignages: MURET (31) 24.06.2014",
          "text_sha256": "6cc6386eb571afbbe57c9ee3a5b4b8e42bf4a265a746474d4a112b45308e7c7c"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
