          "source_text_sha256": "e34b09e2f994bfab93b428960d19c2da82773f03c1589f5e0e2e023be948e1a2",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation on a Saturday evening of the close and silent passage of a glowing object undulating on a straight trajectory: misidentification with a cluster of festive LED balloons.",
