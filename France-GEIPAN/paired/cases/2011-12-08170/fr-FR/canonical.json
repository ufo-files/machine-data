          "start_ms": null,
          "text": "Témoignages: PARIS (75) 02.12.2011",
          "text_sha256": "cf948185c68b0f022071913f293d054c1cb9e745669665f288477f7f59c317e8"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
