          "segment_id": "seg-71f2e28966577e486b1d1afc",
          "segment_index": 12,
          "source_segment_id": "seg-71f2e28966577e486b1d1afc",
          "source_text_sha256": "7859d7a32dc275136cd6db821c810c03daa49088ef07ec905d9fb43e02d69ab7",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of silent movements in the clear sky of a luminous phenomenon with an oval shape and orange color: no overlaps.",
