          "source_text_sha256": "04c89c521da27dcd88027b4ff71474e5a87f9c56e1e47393b70913ca3e4ae96b",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation and photographs of a dark phenomenon on clouds: observation of the shadow of the church bell tower projected onto low clouds, formed by a spotlight located at the base of the building.",
