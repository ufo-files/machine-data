          "segment_id": "seg-e81ad61d367a0f661fcd78d9",
          "segment_index": 12,
          "source_segment_id": "seg-e81ad61d367a0f661fcd78d9",
          "source_text_sha256": "126aacfd09c5cf5a8c566288850e8d93f94dcff9a22a820d051fe0d63f30e911",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of several very bright and multiple-shaped objects flying in the clear sky: observation of Mylar balloons.",
          "translation_text_sha256": "0221546668fdb1613b2917f40ae8dab7f763b333cb906a9e1251d738f0159977"
