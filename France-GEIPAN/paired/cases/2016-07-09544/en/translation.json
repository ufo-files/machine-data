          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent movement of a circular, orange object that changes shape and color after a change in direction: probable observation of a Thai lantern.",
          "translation_text_sha256": "6cc93c88d5faac5f00da26010c1cd506b013ab2f591db0b130a553ae0939e7d9"
        },
        {
          "end_ms": null,
