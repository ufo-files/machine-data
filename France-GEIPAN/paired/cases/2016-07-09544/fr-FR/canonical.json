          "text": "Témoignages: INZINZAC-LOCHRIST (56) 09.07.2016",
          "text_sha256": "3c40fb5f729ff951ff40dc85c879f3dcc7fa72bcf2f73b1a50d4a087035b6408"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
