          "text": "Témoignages: BRON (69) 01.03.2017",
          "text_sha256": "f6949cdcfe7c302d45b5bc4b15ad2808d27683265127ecaf3b77df8bb97357bd"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
