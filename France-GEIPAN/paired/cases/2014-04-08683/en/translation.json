          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Rapid appearance and disappearance of a lit black object during photographic capture: probable observation of a commercial airliner illuminated by the setting sun.",
          "translation_text_sha256": "7f5ce9d7fbef434bfabea50a1f527d4a33ac43bc89278494bc3af4153422af1d"
        },
        {
          "end_ms": null,
