          "source_text_sha256": "07215e8d510fa9d2852a754267baf0b77ea6775934c90fd73931e64111e3a927",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a red glowing phenomenon with a small blue tail near the witness: strange unidentified phenomenon.",
