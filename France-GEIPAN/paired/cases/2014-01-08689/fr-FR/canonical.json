          "text": "Témoignages: THEY-SOUS-MONTFORT (88) 28.01.2014",
          "text_sha256": "91c50ec3d566735a24c2f3e6a5095d5c6dd9eb689703795ba132a66501272ba9"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
