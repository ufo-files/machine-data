          "source_text_sha256": "c50b2b40fda6da4a78123578328327877f266add5f59d4b9aa206c9a031984e2",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a white glowing point with direction change and acceleration: the phenomenon, though not strange, remains unexplained.",
          "translation_text_sha256": "5e4de322a77383e181d2ff5553301f93a0a523aa6bbefe55530cb2efb6b9c4bf"
