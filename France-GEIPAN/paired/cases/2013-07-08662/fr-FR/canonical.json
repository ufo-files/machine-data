          "text": "Témoignages: BAULNE-EN-BRIE (02) 07.07.2013",
          "text_sha256": "da5cc5b616e6f5b4bf107bbaf4bfb975cbc86ab374282bc79958b62f4905fb56"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
