          "source_text_sha256": "aa7abaac7e280f919d907478f536cc7e0dc0b03787735a018eb497bd04b1bdae",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Sequential observations of a phenomenon in the sky: certain observation of an airplane, then probable observation of a satellite reflection.",
