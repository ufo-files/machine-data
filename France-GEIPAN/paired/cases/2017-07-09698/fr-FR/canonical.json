          "text": "Témoignages: LANNION (22) 23.07.2017",
          "text_sha256": "d5b588ad1e8cd5e3f48919134f9aa3b562b850b36133e39e157f44e824fde063"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
