          "source_text_sha256": "b8ec7429238d1756938c8db7489be8a763fd01214fcbd81f2cb2f749ce865959",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of movements in the night sky of a yellow ball: probable observation of a Thai lantern.",
