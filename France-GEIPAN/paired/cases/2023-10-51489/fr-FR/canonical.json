          "text": "Témoignages: FONTAINEBLEAU (77) 29.10.2023",
          "text_sha256": "9ea3dbdfba404a3cf591e7dd3b0fe2d6168f1d2e757ffce7580bde41210e35fb"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
