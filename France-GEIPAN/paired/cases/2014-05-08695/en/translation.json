          "source_text_sha256": "8173718517580e3ce36ee1f8e480108fccd3c0c4ca029d6ba0b550e44748343a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a bright orange-red light mass in the night sky: probable observation of a Thai lantern.",
