          "start_ms": null,
          "text": "Témoignages: CEYRESTE (13) 31.08.2014",
          "text_sha256": "168bf789fa4805d9934174c269be8257cf69c5cad00c0feada408394014f789b"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
