        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-0afa4df30a7ea27cc53516d3",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-a9759ffda426eea7248573c9",
          "segment_index": 13,
          "source_segment_id": "seg-a9759ffda426eea7248573c9",
          "source_text_sha256": "fa05edede6c43cb72cb1c1c369f87078049dd00b7862e9f86d60d4d7322937ed",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: On November 12, 2023, during an transatlantic flight, a pilot and his crew observed moving lights following apparently random trajectories. Initially, they considered them to be satellites, but remained perplexed by these unusual displays. Of low strangeness and good consistency (multiple witnesses, unique and fairly complete testimony), this case turns out to be an observation of Starlink® satellite flashes (see the investigation report). According to GEIPAN criteria, consistency refers to the amount of reliable and objective information gathered for a testimony. The description of PAN corresponds coherently to this type of observation: multiple bright points with variable light intensity performing apparently random movements, confined to a specific region of the sky. A check using Stellarium confirms that PAN is located at an angle of 45° above the apparent position of the Sun. At the time of observation, the Sun was between 30° and 45° below the horizon. This type of observation, in a similar illumination configuration, has been the subject of a detailed analysis in a dedicated news item on the GEIPAN website, precisely in New Phenomenon Explained: Starlink Satellite Flashes. The case is classified \"A\", observation of Starlink® satellite flashes.",
          "translation_text_sha256": "d494716fc7f14cef5c25eee6051a84d21db2afb81eb92a4214cc5af4b4573408"
        }
