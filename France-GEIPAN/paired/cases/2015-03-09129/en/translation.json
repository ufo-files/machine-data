          "source_text_sha256": "af6d64345bb25d1525eb4fd42df652016d86ec5a5b60dbc064b8324175747bc6",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage of a luminous phenomenon: observation of the passage of a meteor caused by the atmospheric reentry of a natural meteorite that fragments.",
          "translation_text_sha256": "b1a0698511241ccbb060706addcac51b3489eb7f7ce5aba9114f23247c4062d1"
        },
        {
          "end_ms": null,
