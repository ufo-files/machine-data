          "start_ms": null,
          "text": "Résumé: Observation d'un objet en forme de cigare, phosphorescent.",
          "text_sha256": "f61a350943b8c12e2321030c2e4d71db5d7eca573a16a58203b220d3a2d4af50"
        },
