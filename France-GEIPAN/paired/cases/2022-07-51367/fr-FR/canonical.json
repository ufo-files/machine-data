          "text": "Témoignages: AVRIEUX (73) 14.07.2022",
          "text_sha256": "a7802fd962f801433969ed2b85e951292fc906ae5b167edd147fe6e76424a8d8"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
