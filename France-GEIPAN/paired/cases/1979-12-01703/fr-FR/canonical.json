          "start_ms": null,
          "text": "Résumé: Observation d'un objet triangulaire changeant de vitesse et de direction",
          "text_sha256": "99284f4248a9647607c6e2181dfbd587940a218ae5dee1c585c18869450bb813"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.933,
