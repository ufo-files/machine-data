          "source_text_sha256": "c1afbdf006d1c8c99d514700008dd52e4c19410bcb65c56e6f7740daa535f4cb",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of several luminous phenomena in the night sky: observation of stars (Jupiter, Betelgeuse, and Venus).",
