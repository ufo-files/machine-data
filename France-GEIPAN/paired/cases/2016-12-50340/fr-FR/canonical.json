          "text_sha256": "f693d169e6b9b320d67f0d99aaa1e30decd0490650fa075a1ad40405a6ae1ac7"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
