          "text": "Témoignages: PERPIGNAN (66) 23.06.2008 T2 PERPIGNAN (66) 23.06.2008 T1",
          "text_sha256": "0c8ef5ea0a6388d76a238b8ea94b925a161a124f2a7e52eee7706d9464820808"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
