          "text": "Témoignages: JULOS (65) 09.01.2025",
          "text_sha256": "f4adea2bf6423e327228d76904dd3361f2aec4cd9dc80becca9e2bb40f928b57"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
