          "source_text_sha256": "c7e2dfce4bab692ed79a9f3c1fad4924bd0960af9098031e4c69ee0a2b31e5e5",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a straight-line passage of an orange ball with a slight smoke trail: observation of an atmospheric reentry of a Starlink® satellite.",
