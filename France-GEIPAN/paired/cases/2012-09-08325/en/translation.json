          "source_text_sha256": "4e2da6698863e3f3c18c46a0c12c2e57abf44f7c6f4c95808b1d0fe5b1937ebd",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation of a bright white-orange light in the sky: probable observation of a flash from satellite \"ISIS 1\".",
