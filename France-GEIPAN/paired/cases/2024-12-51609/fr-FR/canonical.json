          "text": "Témoignages: FOUSSAIS-PAYRE (85) 02.12.2024",
          "text_sha256": "3d23118b6403b0aec0df381f17595e64eb6ab76fc56d369ac1e67203195f564a"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
