          "text": "Témoignages: WALSCHEID (57) 16.07.2022",
          "text_sha256": "157cda47b2d740bb07c23737245db46368ce68ceb300f05ae967b5c151c6c8fa"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
