          "source_text_sha256": "477d30f719a52f3288501e06cb8fb51ab5e3a160a1e2afc0a032a70bce9782fe",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of an orange ball in the sky then disappearance: certain observation of the planet Venus at its setting.",
