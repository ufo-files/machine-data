          "text": "Témoignages: SAINT-MICHEL-SUR-ORGE (91) 10.08.2015",
          "text_sha256": "d4950b8482b10288e46b01df9371691c850d660ded3e4a91b4998a411e8d21fc"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
