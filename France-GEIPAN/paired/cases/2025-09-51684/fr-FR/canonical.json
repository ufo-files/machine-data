          "text": "Témoignages: SAINT-PRIEST-TAURION (87) 03.09.2025",
          "text_sha256": "701de6193954281dca8f6ec1d5a69906501b3fc611455a508f971f9fe948c41d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
