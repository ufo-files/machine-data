          "source_text_sha256": "7118b68554f40e07e48e8a33cac6b8ca203572a48a6dfcd7c02edf6ba1ad91ad",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Presence of an object on a photograph without direct observation: photograph likely of a satellite flare.",
