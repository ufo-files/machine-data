          "text": "Témoignages: PARIS (75) 13.01.2015",
          "text_sha256": "d20c98de7f6de7552ac62e9b80d1216624f540801981a8f24d8d5165152f0673"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
