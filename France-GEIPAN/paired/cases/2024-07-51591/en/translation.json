          "source_text_sha256": "29ecc3945c1a9e35c61fa6dbfe5bc0a13000cf3a8f92a8c9fe270e6b20a1c357",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent passage of a bright white PAN in the sky: probable observation of a cluster of balloons.",
