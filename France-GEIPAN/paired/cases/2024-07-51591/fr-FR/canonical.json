          "text": "Témoignages: ECHIROLLES (38) 29.07.2024",
          "text_sha256": "cfa99344b8a731cf36931f9b72696252dcfd6052bb596410cb556603a7548fac"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
