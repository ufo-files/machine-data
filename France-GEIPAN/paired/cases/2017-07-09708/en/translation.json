        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-51546a77fc5373ae097fd72f",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-a97b2a9809a3408993a989da",
          "segment_index": 13,
          "source_segment_id": "seg-a97b2a9809a3408993a989da",
          "source_text_sha256": "67526afcadf541e2ac72a021bfb6f93e5e0120e1ca97755bb1e9e658d85235d0",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: On July 12, 2017, a witness located at Place Clémenceau in Pau witnessed a spectacle during the passage of the Tour de France. Their attention was drawn to other people looking up at the cloudy sky in a particular direction. The witness then observed several flat, glowing shapes passing over the top of the Chamber of Commerce before disappearing from view. The witness moved to the Boulevard des Pyrénées and observed other glowing points (straight trajectories and changes in direction) in the sky. No noise was heard. The witness took several photos of the PAN and took daytime photos to pinpoint their observation. Only one testimony was collected. An observation in the sky one evening during a spectacle (Tour de France celebration) in the middle of the city would be hard to consider strange without being reported by other people, especially since there were other people observing the phenomenon, as the witness indicated. Given the context, the most likely explanation is that the festive, crowded evening led to releases of fantasy balloons in the sky. The GEIPAN will not dedicate more investigation resources without further testimony of strangeness. The GEIPAN classifies the case as B: probable observation of fantasy balloons.",
          "translation_text_sha256": "dae07c4ad04d97f84206acc5d643b866e5517ef5ea8004e71e07c1462af8fafe"
        }
