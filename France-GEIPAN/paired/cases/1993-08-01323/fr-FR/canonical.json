          "start_ms": null,
          "text": "Résumé: Observation de lumière blanche provenant d'un avion en phase d'atterrissage",
          "text_sha256": "a1d4dbfd7cdab845419287039bb89e6f499f135117168ea9577d0f66d66a4997"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.95,
