          "source_text_sha256": "75c3cc116ca1d90f2af83ad41a45d4e46936720a0c486168b7a65358dcb77de9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a PAN in the shape of a rocket: observation of a commercial aircraft (Cessna Citation 700).",
