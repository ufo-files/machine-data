          "text": "Témoignages: LUDE (LE) (72) 03.12.2017",
          "text_sha256": "273ba66200868675017b19812257963f66e75c1ecae1f8612647f9a87c0c245a"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
