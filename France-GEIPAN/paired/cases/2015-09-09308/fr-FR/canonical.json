          "text": "Témoignages: PARIS (75) 07.09.2015",
          "text_sha256": "8c552510dd42ca57a10cceff603d41ed6de41eff373409ac4f702f36b1319c73"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
