          "start_ms": null,
          "text": "Résumé: Observation de déplacements verticaux d'un phénomène lumineux : manque d'informations.",
          "text_sha256": "b5d733c3c07758c0d86c118519c88fda29aefa7f5a54fc3dbebe8a9ef6768a47"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.981,
