          "source_text_sha256": "c2f01f82c61f72803d41305d9ecacf004003e1612bb929fbc2a9b98fbc66f557",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation in the sky of a rapid dance of three white circular shapes: very likely observation of a skytracer (laser projector).",
