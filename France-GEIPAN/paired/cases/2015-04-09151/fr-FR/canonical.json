          "text": "Témoignages: MEYTHET (74) 11.04.2015",
          "text_sha256": "7ef6ef685a2de5b5e2b223792d94d7fa02ae5d4d20513987ce6a1ed3d1e6b548"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
