          "source_text_sha256": "3c9ed9a0eb06ad3b48e8b520d570c14a5a22feab1d00f0634f4278cfb34888b9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a white glowing point moving in a circular arc with cycles of appearance and disappearance in the same area of the sky: phenomenon unidentified after investigation.",
