          "text": "Témoignages: MARQUETTE-LEZ-LILLE (59) 22.02.2014",
          "text_sha256": "1ae10e3c83a2299b04fbefb128b056016e224a050283d9b73b4790575e7b1ffa"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
