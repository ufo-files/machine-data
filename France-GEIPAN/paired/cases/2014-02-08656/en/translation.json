          "source_text_sha256": "6afd185951daa1ebd97693291b8b35a6063d41e727f5b2b17f84268de364e32e",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of two luminous phenomena crossing each other: misidentification with the ISS crossing its trajectory with the star Sirius.",
