          "segment_index": 10,
          "start_ms": null,
          "text": "Témoignages: LAMONZIE-SAINT-MARTIN (24) 18.01.2018 T1 Questionnaire terre-R.pdf LAMONZIE-SAINT-MARTIN (24) 18.01.2018 T2 LAMONZIE-SAINT-MARTIN (24) 18.01.2018 [T-Cgei Qt T S,A] questionnaire terre-R.pdf",
          "text_sha256": "a6b6b9620e16ae46ffa166bc20d2e957c985b68b4175554c5871299703b372a3"
        },
        {
          "end_ms": null,
