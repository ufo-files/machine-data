          "text": "Témoignages: GUERARD (77) 12.05.1992 T1 GUERARD (77) 12.05.1992 T2",
          "text_sha256": "773b16fd7638b9945f96679dbb0d9da45eeb0257b14899e7ee2d5e693a16febc"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
