          "start_ms": null,
          "text": "Résumé: Observation d'un phénomène lumineux.",
          "text_sha256": "d1228c740f12b6d896f746e668f2e834e3f601deedfacea8b0ed37e1f9c7af61"
        },
        {
          "end_ms": null,
