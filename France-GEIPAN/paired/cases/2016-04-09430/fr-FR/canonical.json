          "text": "Témoignages: PLOUESCAT (29) 03.04.2016",
          "text_sha256": "c8c678d10ddb686262d15ddcf17349d2914930850d4fd6a96be1aa19e3efc2a7"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
