          "source_text_sha256": "0306058191e10d969dce30b0ededa869839b70a58fd77e41c675e046873f3dc8",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: 30-minute observation of a silent white ball in a low, overcast sky: mistaken for light animation due to a sky tracer (projector).",
