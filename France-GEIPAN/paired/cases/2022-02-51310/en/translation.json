          "source_text_sha256": "2a0c6850c44d6ae1286df03eeee6be630a93f633af5afae098156c0a529197f6",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Very brief observation of the silent movement of a luminous object with a yellow/blue color: probable observation of a LED balloon.",
