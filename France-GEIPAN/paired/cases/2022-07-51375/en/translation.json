          "source_text_sha256": "7a6558c393cecac6e87e78c5f19f688d1409e339ee77f4dce03b7e867c0fb43b",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a white bright point moving across the sky on a straight trajectory: observation of the ISS and photographic artifacts.",
