          "text": "Témoignages: NANCRAS (17) 16.09.1996",
          "text_sha256": "8e4c04ff87e6ae1f53e2c665052ddf430cf548b3eecce71f3802a7c66468e3f2"
        },
        {
          "end_ms": null,
