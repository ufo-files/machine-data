          "text": "Témoignages: LANCON-PROVENCE (13) 19.12.2015",
          "text_sha256": "6cf376ebd5e41f2651635f403dccce85b16b55a2ff93954f360a6541d49976d8"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
