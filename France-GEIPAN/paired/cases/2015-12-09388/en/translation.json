          "source_text_sha256": "62a764ac4db1098129ed3e9cdc385324acdf7756a3add6de4c5b94ed49769c23",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent movement of an orange light phenomenon in the night sky: probable observation of Thai lanterns.",
