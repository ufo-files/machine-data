          "source_text_sha256": "2e6d20b4562b78230efbee9209b7d55240cfd043fcb16bcdc9ad7b7da73dc2a1",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a luminous phenomenon in the night sky: certain observation of the star Capella, accompanied by an illusion of movement and a physiological effect of micro-nystagmus.",
          "translation_text_sha256": "ce6f771c2cf4788d5316a7f3b7b8acf2166745119c9a3868032ad2f385c40386"
