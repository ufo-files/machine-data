          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of an east-to-west movement of a bright point in the sky: observation of the passage of the ISS.",
          "translation_text_sha256": "bbc7fc348917519a5625117e21012c7f02b39a1e013517a3a15a40482e99a1a0"
        },
        {
