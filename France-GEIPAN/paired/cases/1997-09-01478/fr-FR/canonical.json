          "text": "Témoignages: BOUZONVILLE (57) 13.09.1997",
          "text_sha256": "0cda6718b2dbeb19df08674a7701e813b04ebdf2c19aed821247e2fef1ac8064"
        },
        {
          "end_ms": null,
