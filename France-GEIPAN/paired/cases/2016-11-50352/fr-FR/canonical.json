          "text": "Témoignages: VILLENEUVE-LES-BORDES (77) 11.11.2016",
          "text_sha256": "d9999e649b1d73e62b04d0088f746d684f05a54d92d3cf1e0f5c90ead3d42072"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
