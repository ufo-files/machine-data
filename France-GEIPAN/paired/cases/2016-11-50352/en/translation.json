          "source_text_sha256": "7c54cbb4a1c02c79de2e39345350740dc516e4b98d61e256689bb0d0757fef88",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Multiple reports of bright objects in the night sky: observation of stars Vega and Capella.",
