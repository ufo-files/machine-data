          "source_text_sha256": "2ede6c9de12550cccdf8d8209fd39f81c87805ce1b0d09514726e4bafff4dcb9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent movement of a red light in the sky, followed by the descent of a black object that then blends with the mountain: probable observation of a Thai lantern.",
          "translation_text_sha256": "c49ddd6df76554b2c4de8f56187f97f5695084090181d39488bf1e9b1cacb332"
