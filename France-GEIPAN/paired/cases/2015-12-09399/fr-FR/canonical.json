          "text": "Témoignages: SAINT-MAIME (04) 24.12.2015",
          "text_sha256": "5a5f7d3f9a809fa57d9f2ae0df36b4f5b4aa0afd0c1e0804745ad53c4ba3b9b0"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
