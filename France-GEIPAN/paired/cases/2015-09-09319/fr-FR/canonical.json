          "text": "Témoignages: CASTRES (81) 20.09.2015",
          "text_sha256": "3fdbee7c8be3c2c378932b580483aaaa534fef238e6a8903483bd183ade2728d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
