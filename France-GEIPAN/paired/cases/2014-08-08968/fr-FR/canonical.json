          "text": "Témoignages: ZONZA (2A) 28.08.2014",
          "text_sha256": "02dd95dac6e84cdb522d2691e70e5abe041fe74767c3d86f4f74e709c6c971f0"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
