          "text": "Témoignages: SCHILTIGHEIM (67) 01.10.2013",
          "text_sha256": "28a3241d5af56a27ba22d6d5f37ff3d5a7cbe87ab9bc38d2dd9121846d360e08"
        },
        {
          "end_ms": null,
