          "text": "Témoignages: SAINT-AMBROIX (30) 18.01.2017",
          "text_sha256": "6f9ea135f0dd8d94f15b08fff027a4090f04cb325d4624ad7155051d37492f20"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
