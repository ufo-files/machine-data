          "start_ms": null,
          "text": "Témoignages: THUMERIES (59) 04.04.1982 T1 THUMERIES (59) 04.04.1982 T2",
          "text_sha256": "226d58f7c3401bfd35b35fe127bac05744775ec4a8bf78f7ea1b8625b1bade61"
        },
        {
          "end_ms": null,
