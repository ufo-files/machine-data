          "text": "Témoignages: BORDEAUX (33) 05.04.2010",
          "text_sha256": "0a9ee53b5c3cc53aaec8ac9f5c503897e3691329575e7df5d367acc0c6a7766f"
        },
        {
          "end_ms": null,
