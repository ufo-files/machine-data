          "text": "Témoignages: CONDAT-SUR-GANAVEIX (19) 02.03.2014",
          "text_sha256": "e4a2b25bd061f1d84768388e6d2d07115ecb341348f13ab67b7a8245aa0db780"
        },
        {
          "end_ms": null,
