          "text": "Témoignages: CAVALAIRE-SUR-MER (83) 04.07.2023",
          "text_sha256": "705a9291d9d64e105b2b476155aebc7958a93c346d745e11926d3e96b1510f42"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
