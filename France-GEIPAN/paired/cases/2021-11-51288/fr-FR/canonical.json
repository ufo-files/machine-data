          "text": "Témoignages: CREGY-LES-MEAUX (77) 25.11.2021 compte rendu enquete.pdf questionnaire technique-R",
          "text_sha256": "f88961103e38caeb480cf1cd099bd25d3a2865ff722a00cd78162babd4ab84fd"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
