        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-37880eccb1506c8660219732",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-7244dc5e4adfac197c9d2622",
          "segment_index": 13,
          "source_segment_id": "seg-7244dc5e4adfac197c9d2622",
          "source_text_sha256": "27d91b2589ecc4f00857781c88bc3268725541e1e831c578ed9d9d112bf3c467",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: On Friday, July 5 at 8:45 PM, a witness on their terrace had their attention drawn by the silent movement across the sky of a black object. He first thinks of a black bird with white wings, but he notices an \"effect\" that intrigues him. The observation lasts approximately 15 seconds before the object is hidden by the roof of a dwelling. Only one testimony was collected. The witness describes what he initially thinks is a bird with a black body and white wings, but he realizes that the white effect was due to light, like a scan from top to bottom. That single characteristic leads him to abandon the hypothesis of a bird and think that this flying object is strange. At sunset, the rays of light are flat on the wings of birds, and can cause bright reflections, even on black wings. Since the movement reported by the witness is completely similar to that of a bird, the strangeness of this case resides exclusively in those clear reflections on black wings, which is not very surprising. For example, see the images of a cormoran and a great raven. The GEIPAN classifies this case as \"B\", probable observation of a black bird illuminated by the setting sun.",
          "translation_text_sha256": "5bab96e1251bfff0d9acaf961993d30017c6a83ce422246292bc6899a6412143"
        }
