          "source_text_sha256": "72f8f6e7e00d8e3667cad2fecb078f4b46bf254342559a893dfb8b1e0946e87e",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a brief, rapid movement of a translucent triangular shape in the sky: lack of information and cross-references.",
