          "text": "Témoignages: GENESTON (44) 27.12.2010",
          "text_sha256": "b9586698da9d6e650ea2687e02ac4b8571c071b9b138f976ddcca6ee481526c8"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
