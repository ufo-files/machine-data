          "source_text_sha256": "4faef0f2d9a2acacca0d943e07d2cece40c5d5f7fd0868fa438426d113082747",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Very long observation and from different locations of several lights in the slightly cloudy sky, then a glowing stream sweeping the horizon: probable laser light projections onto the base of the clouds.",
          "translation_text_sha256": "bd81d8c2e8c9bfb9ab04868be1d00d763512f13f1ed40355f8c107be33cf2bad"
        },
        {
