          "source_text_sha256": "36d5f8618a028ea838e6bd19a9bd9d859bbc357c267728c82a5e7e2e3e0ffc80",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation by a motorist of a PAN at very low altitude: observation of a military aircraft.",
