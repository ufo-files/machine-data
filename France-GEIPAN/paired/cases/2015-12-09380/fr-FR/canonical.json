          "text": "Témoignages: LOURDES (65) 25.12.2015",
          "text_sha256": "f42a47f177fe5229739fe14afd5198bf898d000177721a17de3685ab6d223c39"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
