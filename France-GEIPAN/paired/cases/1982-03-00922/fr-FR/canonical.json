          },
          "ocr_confidence": null,
          "page_id": "page-185b6717970734d6678284e4",
          "segment_id": "seg-61ae3206d19d2a0c6e5441cf",
          "segment_index": 11,
          "start_ms": null,
          "text": "Description: Le 1er février 1982 entre 23h 20 et 23h 30 plusieurs astronomes amateurs observent avec leurs jumelles une quinzaine d'objets qui se déplacent dans la direction Sud-Sud-Est sans faire de bruit. De forme légèrement allongée et colorés, ils sont très lumineux. Aucun changement de forme ou de couleur n'est remarqué durant l'observation. Les informations disponibles ne permettent pas l'analyse du phénomène.",
          "text_sha256": "8c4149c83c6cf2859d920fb8f4f6506519f4f6d96ba915ea2f6daf1f07cdb5f3"
        }
