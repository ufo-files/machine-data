          "text": "Témoignages: CARSPACH (68) 12.11.2008",
          "text_sha256": "2d2c01b4c4e4547ac2beb5e4fd94ddf5d4e9686c17a3951c7a9462f9e34163e2"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
