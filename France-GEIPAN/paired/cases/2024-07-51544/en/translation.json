          "source_text_sha256": "e5cff61d4d3c4ec0a1b66109a9843159f9faed3a181db31ffc6384acfcf34fc9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of unusual movements of two \"red-brown\" orbs in the night sky: phenomenon unidentified due to lack of data.",
