          "start_ms": null,
          "text": "Témoignages: BILLY-MONTIGNY (62) 14.07.2019",
          "text_sha256": "392a5b83bfaa91556fddb4ac4f03114907ddd06403d7a001f75010799c504360"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
