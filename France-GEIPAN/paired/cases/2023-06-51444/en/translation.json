          "source_text_sha256": "a93268e73568ebe7c5e92ffdb720f748d125104fd01ea4c6cba33ba07d91b9b4",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a passing in the sky of a round black shape with kind of \"flames\": very probable observation of a mylar balloon.",
