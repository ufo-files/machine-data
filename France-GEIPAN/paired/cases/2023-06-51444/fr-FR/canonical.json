          "text": "Témoignages: SCEAUX (92) 04.06.2023",
          "text_sha256": "1462094becd7e90af7b7c7e8f2a6b2f144b7b83257b6f7110c223a12fe60fe5c"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
