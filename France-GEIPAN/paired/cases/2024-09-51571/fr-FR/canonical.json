          "text": "Témoignages: EMANCE (78) 14.09.2024",
          "text_sha256": "03bdb836077ee237042aeaf526bae2acdfdb237ef84a34937742342e3a1decf2"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
