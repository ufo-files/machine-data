          "source_text_sha256": "76976d704dd1fe2c291e00861f849520e899e8588ae78cef2e86d48b163a4eee",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage in front of the Moon of a PAN in the shape of a large \"cigar\" with a single white light at the front: observation of a commercial aircraft.",
          "translation_text_sha256": "aca665b0a957d71d82b5d674598cac44bb6b0326c29de4bf733d77ee2f676ac3"
