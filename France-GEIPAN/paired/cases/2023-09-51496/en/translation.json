          "source_text_sha256": "fe50d1c8abca7753af9a7cce59e7de2537d7e0db5ccb85cafe6ae7d4a84823e5",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of the silent passage across the sky of a dark PAN composed of several shapes, one of which had a gap revealing the sky: probable observation of balloons.",
          "translation_text_sha256": "53eb8b3a4e3a736dca6fca8ede7a06c9356a1726c09a2b6fac97f71e302ccbb0"
