          "text": "Témoignages: AMMERSCHWIHR (68) 15.07.2015",
          "text_sha256": "cb26b4a8f9ae0a8be00c0305b3c3b16103e3194c89e97f571b4466f456920362"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
