          "text": "Témoignages: AIGUES-MORTES (30) 07.07.2021",
          "text_sha256": "36edbedeeeb18ff4702747bd69da75653e410564b62cfd9128a61ff7c8835228"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
