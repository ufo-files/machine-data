          "source_text_sha256": "ed2e6bd7fac5921ed58b7f54529e407e468c0f829aaac24e33e6d62eff150051",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation of the movement in the night sky of two \"spheres\" of dim white color: likely observation of birds.",
