          "source_text_sha256": "387dcff1531d01685549f314576e51d931eb8eef633d4e84106f10e77a440c0b",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent movement of two orange-fire light phenomena that extinguish simultaneously: probable observation of Thai lanterns.",
