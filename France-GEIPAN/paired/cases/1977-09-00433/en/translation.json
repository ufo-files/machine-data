          "source_text_sha256": "331356746818ad2e48e716a58b031efd4fe5951582df1afad60642fcb0cc32a8",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of a glowing phenomenon disappearing behind a hill but continuing to illuminate the landscape: mistaken for the Moon setting.",
