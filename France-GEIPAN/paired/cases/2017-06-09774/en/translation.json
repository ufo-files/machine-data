          "source_segment_id": "seg-7bd17fc21c69a6d442299b09",
          "source_text_sha256": "f97c36781de4f598d0e1e86aa737bea388201284ceef3c099912bc4d5100b0c3",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a fixed, double-lobed bright point: Venus observation.",
