          "source_text_sha256": "2626e7fecab4e441ecb6df47217dd9fcddc8c251b8e83ba41cc98e94b33761a8",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation of the passage of a dark triangular shape and rapid departure: probable misidentification with an airplane.",
