          "source_text_sha256": "f73c30ef1b86a5e07d1d0a2d04e53676605f57afba80feec2a55f2c78bb0888f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Multiple observations and recordings on a surveillance camera of bright flashes at low altitude; no noise heard: observations of distant lightning.",
          "translation_text_sha256": "7ea5fc2ddca8dcd1beffa33ead8276fb2e5c56b2e6032aaeebf50a8286bdc3ef"
        },
        {
          "end_ms": null,
