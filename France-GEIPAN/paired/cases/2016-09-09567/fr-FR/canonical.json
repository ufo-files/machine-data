          "text": "Témoignages: CAUFFRY (60) 29.09.2016",
          "text_sha256": "1d1f78c8c0a8ee18f52fcc2d669c6e806c9182208711c80798a593340957c2a7"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
