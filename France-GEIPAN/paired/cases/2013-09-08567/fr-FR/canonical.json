          "text": "Témoignages: SAINT-OUEN-L'AUMONE (95) 05.09.2013",
          "text_sha256": "0f9e7c63540a5af10f9475fc5e7c10badfdf9e40817093fb4475298a7034a21d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
