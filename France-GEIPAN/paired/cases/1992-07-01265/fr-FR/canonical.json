          "text": "Résumé: Observation d'un objet rouge en forme de ballon de rugby",
          "text_sha256": "6e005f2d0364d2ebce60c4735f5b1679d0fbe76980948a8b61d2b2ade443f1bf"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.914,
