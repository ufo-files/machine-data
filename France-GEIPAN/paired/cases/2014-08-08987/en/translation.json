          "source_text_sha256": "45612733f29ae8556517ebe5ae986f8ecd47089cd9bba316c14142190b4d2344",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation from an airplane cabin of a PAN rectangular object and trails: observation of a commercial aircraft trail.",
