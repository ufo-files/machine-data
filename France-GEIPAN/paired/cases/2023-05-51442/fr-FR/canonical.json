          "text": "Témoignages: ROUEN (76) 24.05.2023",
          "text_sha256": "8ee1141c2b86f233af180152fe36d90841c2b353c3bef5abd36593f4b82c94b5"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
