          "source_text_sha256": "18a5590f335a889c0ec7df6a16adeb6b7069b9cf763aa32560f66d8a122cece9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Nighttime observation of a straight-line movement of a white glowing ball in the sky: probable observation of a luminous balloon.",
