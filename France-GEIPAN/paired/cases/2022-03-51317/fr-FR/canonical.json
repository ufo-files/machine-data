          "text": "Témoignages: MARZAN (56) 19.03.2022",
          "text_sha256": "55b0edb49bb5e21a3f9a899f7a89b7a5bd1c65f06ca16a80f43dbbe6e85ba47d"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
