          "source_text_sha256": "362f38c37b258a18fcc31b2e62ee483ff1e01ba25b1e82f2f978436b4d81efa9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Nighttime observation of a low-flying triangular shape delineated by lights: observation of a helicopter in flight.",
