          "source_text_sha256": "bbfc34addde6a9ebe1df847e22207ef6af12ad313b51221a5d5321bd6f4315a2",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a straight and silent passage in the sky, of a PAN of spherical shape, orange in color and with variable intensity: very probable observation of a celestial lantern.",
          "translation_text_sha256": "c82312aae446396b504ebe3cdc7f1b3d5613936e834e09f7e5e0e4bfcd9ac89e"
