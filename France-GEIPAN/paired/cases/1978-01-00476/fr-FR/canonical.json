          "start_ms": null,
          "text": "Témoignages: GUIPEL (35) 13.01.1978 T1 GUIPEL (35) 13.01.1978 T2",
          "text_sha256": "04ca26b846a2b0d10c0094a24d9a955581c85d0d571ef2b212b41e92044fa3b6"
        },
        {
          "end_ms": null,
