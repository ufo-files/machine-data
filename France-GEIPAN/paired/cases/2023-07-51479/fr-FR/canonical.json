          "text": "Témoignages: CHAVILLE (92) 13.07.2023",
          "text_sha256": "b1909247174ba766832652105950446606d95bc216450880dd6f3b4afa787a9e"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
