          "text": "Témoignages: CUXAC-D'AUDE (11) 12.08.2023",
          "text_sha256": "7d58cedf86d11ec14b646fd5c3d4fe9f926241081332c798a6eada9923fdd921"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
