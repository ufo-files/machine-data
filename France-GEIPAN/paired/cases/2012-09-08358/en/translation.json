          "source_text_sha256": "7c087b0674d8e9c7c2cd6e3b128766acdb80b04382d53eeefa32bbb676441da8",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observations of the silent passage of several dozen glowing spheres in the night sky: observation of Thai lanterns.",
