          "segment_index": 11,
          "source_segment_id": "seg-aaf042c5476cb72a38e59a17",
          "source_text_sha256": "6071c99dea5fc8be79f0f0fd109f19f09ec4e2cd483a60ac3c287ae487875099",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of 7 bright points in the sky: probable observation of Thai lanterns.",
