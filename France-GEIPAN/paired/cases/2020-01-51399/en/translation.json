          "source_text_sha256": "b6a2669e17297e1ae89c19693a04b2b9410a0f1f347b3d239e7bf9ebae580b82",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Testimony in 2022 of an old observation (2020) of an object \"made up of cubes\" first stationary then in motion in the sky: lack of information.",
