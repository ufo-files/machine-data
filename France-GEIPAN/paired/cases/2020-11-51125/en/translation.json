          "source_text_sha256": "1000317bf87f50ba912a149b8f72a77db0c1b2654099dc73f64ed0786e663255",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Multiple nighttime observations of \"craft\" in the sky: astronomical misperception.",
