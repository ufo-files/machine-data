          "text": "Témoignages: OULLINS (69) 20.05.2016",
          "text_sha256": "7bddb50ebcab23cab909d4bc8e316b00dbbe2e217af013c21b14e99be8f3d71c"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
