          "source_text_sha256": "45650dafc1b11334fd53c01a94eb16bd6a74bc24b40256d8ab4a4e3e31eadf99",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a gray metallic sphere in the sky during the launch of an experimental rocket: likely observation of a balloon.",
