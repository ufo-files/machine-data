          "text": "Témoignages: VEYRIER (CH.1255) 26.03.2025",
          "text_sha256": "36d91f5bbe067b816a97aadf14f67cdba9abd7a98d34e39bee6950b1e344aa80"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
