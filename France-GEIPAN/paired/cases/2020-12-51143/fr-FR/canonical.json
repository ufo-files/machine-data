          "text": "Témoignages: PLOUHINEC (56) 12.12.2020",
          "text_sha256": "35e446fb6cf99786f1cff810556a47622002046fd5a842739f8d40f0d922873b"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
