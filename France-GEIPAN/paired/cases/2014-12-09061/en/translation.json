          "segment_index": 11,
          "source_segment_id": "seg-d6ffa720fd1f0e3286d89ecf",
          "source_text_sha256": "3be3e8025ed7f523474bec849f69a8c3aabdd79dc113f747d9dab71f5d820fc6",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a glowing object in the sky: probable observation of a star (Vega) above the horizon.",
