          "segment_index": 12,
          "source_segment_id": "seg-ec90d4bebef4d6f324f5cce3",
          "source_text_sha256": "a3c9708252d23e2a7633715b3fd65407d59dbe798094ebe01c4a8be549e27bb9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a triangular shape in the sky bounded by fixed or flashing lights: likely observation of an aircraft passing by.",
