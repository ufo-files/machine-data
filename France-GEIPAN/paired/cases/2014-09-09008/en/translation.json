          "source_text_sha256": "6b49d0d8a1ee1caf85d1dcece7227e6c8cbf545272aa8151f5e8ec5b6b8ab911",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent passage of two flashing red and white lights: observation of an airplane in a holding pattern prior to landing.",
