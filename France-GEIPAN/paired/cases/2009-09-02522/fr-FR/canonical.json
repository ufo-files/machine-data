          "start_ms": null,
          "text": "Témoignages: CHAHAIGNES (72) 13.09.2009 T1 CHAHAIGNES (72) 13.09.2009 T2",
          "text_sha256": "f2db923e58b1324cc795a11079624ffb5ab2e495c929f2ae0a6d413d4eb0371c"
        },
        {
          "end_ms": null,
