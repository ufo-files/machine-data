          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation of the silent passage of a PAN spherical yellow-orange object in the night sky: likely observation of a sky lantern or LED balloon.",
          "translation_text_sha256": "3d0793c8c2e2bee540fde98fea5a7a8b9dcb4bec263d126c5bcc8b21bdd018b4"
