          "source_text_sha256": "0c492f3651af8dfa4ce8d712fcc159a6314d7afd3ac994e8fd2ed8400b0a6695",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage \"of a tube\" with many lights in the night sky: observation of the passage of a Starlink satellite train.",
