          "text": "Témoignages: CHEVIGNY-SAINT-SAUVEUR (21) 11.02.2016",
          "text_sha256": "a3c8dd8a0ae68ef11a3adf93eaecc9bb487cce0e88085a03b4074d0a2a6ebcf7"
        },
        {
          "end_ms": null,
