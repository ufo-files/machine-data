          "start_ms": null,
          "text": "Témoignages: ESCHENTZWILLER (68) 22.02.2015 T2 HABSHEIM (68) 22.02.2015 T1",
          "text_sha256": "b785aa27a9886351d2e63382fa8160d1eac1c30e83c3007b5aa56526d0619812"
        },
        {
          "end_ms": null,
