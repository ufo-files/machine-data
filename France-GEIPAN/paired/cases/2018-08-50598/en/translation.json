          "source_text_sha256": "eca4105c3e7e77dbbcb1e07d62caed43b1207e4ab82a9349789f72eeefa81acd",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage through the night sky of three bright points forming a triangle and moving at the same speed: observation of the Yaogan 31 triple satellite.",
