          "source_text_sha256": "0ab995b2f152258886af57f06b5b1ff59085b1eefc7a64373c1359be6242645c",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of an object in the shape of an upturned soup bowl, fluorescent orange in color, silently moving across the night sky: probable observation of a Thai lantern.",
          "translation_text_sha256": "3ed53abec59f9cda45f46391e6c93f81c98d02352168c5400814124caac82c91"
        },
