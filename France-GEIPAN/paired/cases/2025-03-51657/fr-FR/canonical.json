          "text": "Témoignages: BEAUMONT-SUR-SARTHE (72) 22.03.2025",
          "text_sha256": "c172012dea2fb296a89ef3db31cab94e739942eb33fcf22871fb4954b522bb2e"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
