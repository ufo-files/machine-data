          "text": "Témoignages: CIVRAC-DE-BLAYE (33) 23.12.2024",
          "text_sha256": "bbc7c490dbe81d28f96f6f20b87086037e475a5e32f7cada5af3142c445fab78"
        },
        {
          "end_ms": null,
