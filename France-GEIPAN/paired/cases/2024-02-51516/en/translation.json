          "source_text_sha256": "933ea90e1f616c2c14de3cacb52ccbbf897d7d75f6f9f3f6bc2eb1b7cbd1a262",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the quick, straight, and silent passage of a black point across the Paris sky: likely observation of a festive balloon carried by the wind.",
