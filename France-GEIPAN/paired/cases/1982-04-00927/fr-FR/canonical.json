          "start_ms": null,
          "text": "Résumé: Observation d'un objet se déplaçant lentement à vitesse constante",
          "text_sha256": "0eea2720abfb695f073320bc00ecc17182d8e423c077f9eb225cd2ec17fba532"
        },
        {
          "end_ms": null,
