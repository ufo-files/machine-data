          "field": "description",
          "page_id": "page-7a6301ca6aaed802c0d6f784",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-c27001d14ee14d42ba685603",
          "segment_index": 13,
