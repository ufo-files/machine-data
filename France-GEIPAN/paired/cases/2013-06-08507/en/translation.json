          "segment_index": 11,
          "source_segment_id": "seg-ea1825765a5a6da50e5f08c8",
          "source_text_sha256": "abe0a5400b60be95728df639aca249b0835e90f3cb849efb9e86dff89a223881",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the simultaneous and silent movement on an ascending trajectory of two polygonal shapes: likely passage of festive balloons.",
