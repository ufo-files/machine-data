          "source_text_sha256": "d232a402f9e6f2c7e655410d567a2c117a7afb8bdcbb46c99f8a98afa62b024a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a black, oval-shaped object reflecting the sunlight and appearing to move slowly; rapid disappearance: probable observation of a captive solar balloon.",
