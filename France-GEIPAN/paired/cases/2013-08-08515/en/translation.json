          "source_text_sha256": "6a5ff477a6abe4b944f0d05ace5d8c469d0c5a8257646b47b1ac45819c2c36d8",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a very bright point in the sky with intensity and movement variations: mistaken for a flash from satellite Iridium 95.",
          "translation_text_sha256": "0af20de7834b1579d142337b536a8505d580657f528bb8d17d4f0343fa3feec5"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-3730cc364c2228a7339ef061",
          "qa_findings": [],
