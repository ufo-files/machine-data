          "segment_index": 10,
          "start_ms": null,
          "text": "Résumé: Observation du passsage d'un objet lumineux. Aucun bruit.",
          "text_sha256": "8a3cc7e26d7617e40202c4a72f8897ab12c6f79297ac8c934195b92ec0d4220d"
        },
        {
