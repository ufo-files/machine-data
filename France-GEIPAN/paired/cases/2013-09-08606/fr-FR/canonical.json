          "text": "Témoignages: LOURDES (65) 22.09.2013",
          "text_sha256": "50e230e7d4c6825a31350a2af779fb626db4e9b1fcfda507cc7e3d9af5545ae5"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
