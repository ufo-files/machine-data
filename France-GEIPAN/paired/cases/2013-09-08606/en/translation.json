          "source_text_sha256": "6aa39a5d5d7b5f951ac2c62a773602ca524f16ac789ab777206d98b6f9bb68c3",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Sequential observations of luminous phenomena in the sky: astronomical observations of Venus and the passage of a bolide.",
