          "segment_id": "seg-9c90ea09fe46169a34bbf95d",
          "segment_index": 12,
          "source_segment_id": "seg-9c90ea09fe46169a34bbf95d",
          "source_text_sha256": "bba5102ab64ddd7554e62d1e73c34bfff8e7368eda975ac8d1071ab9d9b3ab2b",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a dark, fixed object with irregular blinking. Low altitude: probable captive balloon.",
