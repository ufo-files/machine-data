          "source_text_sha256": "e8cbfb20db1412d02598beab377992057740b029bd56df3e99078cad44784639",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the straight-line movement of two egg-shaped objects reflecting sunlight: probable observation of aircraft.",
