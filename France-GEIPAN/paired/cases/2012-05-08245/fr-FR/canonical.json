          "text": "Témoignages: DOUDEAUVILLE (76) 28.05.2012",
          "text_sha256": "697498efc1e359f1881e10c624e1c573c7dda3714997014809e0ea7d61ad416c"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
