          "text": "Résumé: Observation probable de passages de la station MIR",
          "text_sha256": "f08fe2f5374fbd490dde753cf061aa3cbee2985daff2f3fee197c7fd515aa8ad"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.952,
