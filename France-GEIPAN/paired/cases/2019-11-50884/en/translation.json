          "source_text_sha256": "eb10461f0cedeb5a1cf9b8bece1a5d1ea582c3f71ea35a8ec3bd4305af8eaa6f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of many moving lights in the sky: misidentification with a training flight of drones.",
