          "start_ms": null,
          "text": "Témoignages: CESTAS (33) 15.11.2019",
          "text_sha256": "097068c875aeadc6617afb1e981216cd280b07a919b86ca37eda2dd48bf07e74"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
