          },
          "ocr_confidence": null,
          "page_id": "page-ae39db4a5cc3093658884b78",
          "segment_id": "seg-42a40d559e349def90569958",
          "segment_index": 11,
          "start_ms": null,
          "text": "Description: Le 21 novembre 1992 vers 18h30 un témoin en voiture observe une lumière verte se déplaçant très rapidement. Malgré l'aéroport proche le témoin pense qu'il ne peut s'agir d'un aéronef. Bien que le témoin se trouvait en compagnie de son conjoint, un seul témoignage a été enregistré. Aucune autre information n'a pu être recueillie.",
          "text_sha256": "cc6c3d22dd569e800c783636ba7b3fcf04f2bb712bbd7be96a468d9c6eb2c11d"
        }
