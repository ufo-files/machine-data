          "text": "Témoignages: SEMUY (08) 24.02.2019",
          "text_sha256": "19eac91eb18eb80752c7dc6328ea136f02e16e4e674baf263070e5b5c8ad8866"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
