          "text": "Témoignages: CHECY (45) 03.07.2014",
          "text_sha256": "7e5f951c28c4ab467699dbe663e1dbcbd4fb57e244ffb553c6fcc19f0173d172"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
