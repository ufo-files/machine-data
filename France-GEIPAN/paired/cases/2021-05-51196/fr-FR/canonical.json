          "text": "Témoignages: LAON (02) 20.05.2021",
          "text_sha256": "0fa7a23f675f1832056cb2d8977f9b04a15615819f80e8c76ea5784be1461afd"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
