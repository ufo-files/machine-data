          "text": "Témoignages: SAINT-MEDARS-D'EYRANS (33) 14.06.2021",
          "text_sha256": "10766cff1f430a484dcd2dbc225652f4ceb5b1b877433db8f340bcb31ba543b5"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
