          "text": "Témoignages: AVIGNON (84) 10.05.2008",
          "text_sha256": "ea31bae436b3e33858be968adc75409a06982b3c59d28dce1ca1ddc36aa11088"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
