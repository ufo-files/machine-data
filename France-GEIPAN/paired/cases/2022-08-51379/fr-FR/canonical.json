          "text": "Témoignages: WOLFGANTZEN (68) 12.08.2022 questionnaire technique-R.pdf",
          "text_sha256": "54300e9f6457f1f9d73602c7efc626ce14ff64f7152473722ca952b1b30957a2"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
