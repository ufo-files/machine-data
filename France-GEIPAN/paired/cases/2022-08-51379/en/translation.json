          "source_text_sha256": "8f0112a108beb32eab879a67f73ecf4b73eb7b90f18b7efc6c58bb7e9be38e19",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a white glowing object in the sky: observation of a commercial aircraft.",
