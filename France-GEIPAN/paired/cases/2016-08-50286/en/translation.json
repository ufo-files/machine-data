          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Nighttime observation of the rapid passage of a bright point through the sky on a particular trajectory: likely observation of a meteor.",
          "translation_text_sha256": "a0f0e29a08b00f3af9c32433b0b71255bd589b885cf6e4e67871526e87118ee4"
