          "source_text_sha256": "e5b1fc10c890ac5d49f2fe8c295a12a19dbcc9a41f763ea4aac49a51f89009e1",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Evening observation of the silent passage of a bright white cigar-shaped object: observation of an airplane.",
