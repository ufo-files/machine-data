          "text": "Témoignages: LOYETTES (01) 02.08.2019",
          "text_sha256": "c91dc6943cdb2d10b472d874451b179a0d4e5d2a3e5aa1cd663b4d5751fb0923"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
