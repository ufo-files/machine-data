          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observations of the silent, rapid movement across the sky of a luminous phenomenon on a straight trajectory: re-entry into the atmosphere of a small meteoroid.",
          "translation_text_sha256": "9da0d8287a3c744236b7fde3891e1e0b2d39c944cb390e208f5db4571cb312fb"
        },
