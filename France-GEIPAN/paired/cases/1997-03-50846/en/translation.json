          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of two lights (white-blue) then an oval shape at low altitude and sudden departure: misidentification with a type MD-80 aircraft.",
          "translation_provenance": {
            "method": "reused-existing-translation",
            "prior_translation": {
