          "source_text_sha256": "e4306fc48b70a3c1557f2ee3390103003dbafc05c8848c9cc1c8a443e70b248c",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of 2 lights projected side by side followed by a \"sort\" of cylindrical fuselage progressing towards the East horizontally: probable observation of aircraft.",
