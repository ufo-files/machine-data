          "text": "Témoignages: EMERAINVILLE (77) 05.06.2017",
          "text_sha256": "dfd8dc0f9c46483b7154760c125d0cee92933a4d40cd1e33ef8f0ec801d73e41"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
