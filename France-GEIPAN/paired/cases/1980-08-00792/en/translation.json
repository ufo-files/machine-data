          "source_text_sha256": "f323f2f99a07cf5e7cee8ca65046a92a54645d6a41311e5116dcfaa5a635d8a2",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of an object of color \"polished aluminum\" that oscillates on itself and moves: lack of information.",
