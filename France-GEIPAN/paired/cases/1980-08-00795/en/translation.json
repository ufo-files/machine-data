          "source_text_sha256": "ad74b5cdb7cdddab8ef6761ad70f4212f3c9b5ccb833623c7657f3b26f685747",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a luminous phenomenon in the shape of a crescent that appears to follow the witnesses: astronomical misperception of the Moon.",
