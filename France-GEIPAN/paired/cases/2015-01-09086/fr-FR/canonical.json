          "text": "Témoignages: LOUDEAC (22) 31.01.2015",
          "text_sha256": "33280c9773f5fea401e1c6b8171cbb94d0612ba8555936392677483ce6760c55"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
