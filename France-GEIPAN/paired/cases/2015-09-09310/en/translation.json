          "source_text_sha256": "b19b844bf8fe8fdf5440c955d3904591f3e109c285e364d0aa0d8812a0f90c6f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of unusual movements of a bright point in the sky: probable misidentification with a satellite coinciding with the observation of a meteor.",
