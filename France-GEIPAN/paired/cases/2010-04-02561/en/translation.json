          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: In-flight observations by multiple crews of a light with color variations: very probable observations of the planet Venus on the horizon.",
          "translation_text_sha256": "c544a069f99b4e869baed508e40cc8dd767d30dc2bc5fbeed3f488526d656bcb"
