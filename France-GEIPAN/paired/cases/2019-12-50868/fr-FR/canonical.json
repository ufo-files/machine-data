          "text": "Témoignages: SOUSTONS (40) 01.12.2019",
          "text_sha256": "b410aa9331447fdca341fcc99f0de6ceceb2bcecf2c4f515b5903fe1eaf6ac36"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
