          "source_text_sha256": "c71b0dbad6a879d1ef1818bda1aa4c8b31f4183d058f326eaccb685cadd6d999",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation of the movements of two superimposed spheres in the sky: observation of a Mylar-type fantasy balloon, carried by the wind.",
          "translation_text_sha256": "075eeeb9768773da10a26fb85174503cc0c6a9db1e2939e6d805dfee622d783c"
