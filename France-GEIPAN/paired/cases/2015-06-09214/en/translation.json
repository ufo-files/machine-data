          "segment_index": 12,
          "source_segment_id": "seg-d2da1e9c11d04b8e6bc46e8a",
          "source_text_sha256": "2a20e9099a9a70534b52a4368fd8b542a8cd0164bcad64e8a58c0e7e049f7d2f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of two bright points moving very slowly one above the other: conjunction of Venus and Jupiter.",
