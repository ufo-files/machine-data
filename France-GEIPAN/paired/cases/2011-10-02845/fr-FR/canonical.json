          "text": "Témoignages: VAL-DE-REUIL (27) 23.10.2011",
          "text_sha256": "f926522ce8c22ecc3a5cb90d5d958fdebc3abaaaf522f286b7bbdc0be0889d62"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
