          "source_text_sha256": "d8cecc7e8028d3b33ba1646d5462f7b465efa6fb03a2c4c009af306b76b0a5c7",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a scintillating yellow-orange light phenomenon in the night sky towards the SE: observation of Sirius.",
