          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movement of a round object with 4 fins: probable observation of a helium-filled balloon.",
          "translation_text_sha256": "0d21c5dafa3d25aae6df5f93a342929da79c48038c9a1496054af7732cb96994"
        },
        {
          "end_ms": null,
