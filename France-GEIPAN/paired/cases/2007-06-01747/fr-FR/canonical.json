          "text": "Résumé: Observation de Jupiter.",
          "text_sha256": "cd050ea7405698688c0f6d1ff9b5f6b4961ed54cd35381bb473357493cd9ed3b"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.935,
