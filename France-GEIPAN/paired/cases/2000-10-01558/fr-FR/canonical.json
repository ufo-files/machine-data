          "start_ms": null,
          "text": "Témoignages: [AERO AFR] de ORLY (94) vers GRENOBLE (38) 08.10.2000",
          "text_sha256": "da8b1634b3682c7b0e95f6833084fb210deb9c4d0650cba5af5710a52df7260f"
        },
        {
          "end_ms": null,
