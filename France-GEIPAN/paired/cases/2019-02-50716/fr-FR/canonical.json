          "start_ms": null,
          "text": "Témoignages: BERTHEGON (86) 13.02.2019 T1 Questionnaire terre-R.pdf BERTHEGON (86) 13.02.2019 T2 Questionnaire terre-R.pdf",
          "text_sha256": "582ed83b37cfda4dbb3964b85a34e2eb39c6a4d762a208db619e35f9379531ce"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
