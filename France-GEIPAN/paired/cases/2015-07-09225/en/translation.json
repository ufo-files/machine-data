          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long and repeated observations of two bright points in the night sky: observations of Venus and Jupiter.",
          "translation_text_sha256": "0e28e231ff21c649d58c77b2ec493b288b7257657a3c13a088352d25a464addf"
