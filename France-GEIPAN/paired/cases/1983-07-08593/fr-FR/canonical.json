          "text": "Témoignages: SAINT-PIERRE-DE-CHARTREUSE (38) --.07.1983",
          "text_sha256": "cb1ae713c075de34f0c146f739ff5909456296e322cd7076c294cbd2eaf2a4ce"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
