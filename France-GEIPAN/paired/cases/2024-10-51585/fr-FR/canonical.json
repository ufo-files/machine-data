          "text": "Témoignages: VILLARS-LES-DOMBES (01) 20.10.2024",
          "text_sha256": "c6f2d1895d5858b1ef824e80af067d4af4b6f84262214ceeaff84b847220eae7"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
