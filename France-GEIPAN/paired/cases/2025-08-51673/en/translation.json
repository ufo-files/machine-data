          "source_text_sha256": "8c4bb705844f8b0a8000d5dd0f61bec6a21eae628418baedc235be225e0fc592",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Brief observation of a blue light on the move in the sky: probable observation of the atmospheric reentry of a meteoroid.",
