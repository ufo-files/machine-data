          "text": "Témoignages: JOUE-LES-TOURS (37) 31.07.2025",
          "text_sha256": "d38d5e556126a91c102812139c9b6596d9795aa015aa500ce7f12b3ec0ee683a"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
