          "text": "Témoignages: VALENSOLE (04) 01.07.1965",
          "text_sha256": "33c1da5c8974261674c469297686fa9b185c5d44176929373644077faa9faeda"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
