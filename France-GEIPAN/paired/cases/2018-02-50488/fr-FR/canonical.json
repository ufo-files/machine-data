          "start_ms": null,
          "text": "Témoignages: MOUREUILLE (63) 12.02.2018 T1 SAINT-ELOY-LES-MINES (63) 12.02.2018 T2",
          "text_sha256": "db455128e00b7563fcc58a8db476e1cc414d7e12d875b591aaf83e96b1b1a4c4"
        },
        {
          "end_ms": null,
