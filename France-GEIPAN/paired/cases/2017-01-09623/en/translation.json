          "source_text_sha256": "24094a53f8f013661e8bf958928d3fac2a85ec5c0c35d501421155c7ad2d9b7f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Three witnesses observed a grayish fixed object in the sky: observations of aircraft trails.",
