          "source_text_sha256": "8abbf702ccfa5a490784a717cdcef1986fc5e9117a73712921826ad83cf25e8a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of silent movement across the clear, night sky of 27 orange-colored lights: likely Thai lanterns.",
