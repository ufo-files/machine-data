          "segment_id": "seg-b0230672189447e1def03da0",
          "segment_index": 12,
          "source_segment_id": "seg-b0230672189447e1def03da0",
          "source_text_sha256": "69b4e77a53e54dbc2188d1e22e65a0601cd50e5232ef74e66b790b651cf98725",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Long observation of a luminous, opaque, white ovoid object at the zenith: movement towards the East: observation of a technological stratospheric balloon.",
          "translation_text_sha256": "27a207b731c9a7d2aa080c1f89a1ca1eb974b8ae1b44cbe0d53ef8c687153abd"
