          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation in the sky of several black shapes seemingly falling while floating: probable observation of light and disparate debris carried by the wind.",
          "translation_text_sha256": "9e4607202afa2fe0d4cd7c918b84e2a2d54dc5ca4269d2bf8d2e7577c636f4f0"
