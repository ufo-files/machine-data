          "source_text_sha256": "2d7c3ecfdcf87a5df990e02ec8e836d3b1e7a68790d5f2c3bcc90bf7753fd505",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent passage of 7 to 8 orange spherical objects in the sky: lack of information and cross-references.",
