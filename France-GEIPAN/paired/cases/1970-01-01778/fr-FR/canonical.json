          "text": "Témoignages: FORT-DE-FRANCE (972) --.--.1970",
          "text_sha256": "d8e2e73eda5ff91bb4926d18457cc4f3c88c9a1f57a744a28159b67adce418a5"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
