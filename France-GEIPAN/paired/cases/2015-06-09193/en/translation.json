          "source_text_sha256": "9901acb147dc355d4665dc096a97daca91cb65a8f1a0cbcc65b16d14fe4d5fff",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of an object circling in the sky then a straight trajectory; disappearance hidden by vegetation: probable drone observation.",
