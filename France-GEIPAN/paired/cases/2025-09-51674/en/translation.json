          "source_text_sha256": "59e83058c2a70b46406b174aa00f55e70c6ac40460b3581ee21eb43e6c343102",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of repetitive movements of a white light in the cloudy night sky: probable observation of a skytracker (powerful projector) used during a private party/event.",
