          "text": "Témoignages: SAINT-CHRISTOL (34) 04.01.2017",
          "text_sha256": "6c2c8bb47de62078b36769fc5464364d8e1d3d0e20441403e8c5d971db8ac6cb"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
