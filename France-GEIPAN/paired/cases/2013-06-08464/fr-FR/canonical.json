          "text": "Témoignages: ASSEVILLERS (80) 03.06.2013",
          "text_sha256": "5f7f0f383608caf724bd98f190b70e3755b7cea207b5d7b76b8c7b36e59afc8e"
        },
        {
          "end_ms": null,
