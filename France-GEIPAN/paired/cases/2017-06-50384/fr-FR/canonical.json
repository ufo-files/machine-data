          "start_ms": null,
          "text": "Témoignages: POLIENAS (38) 10.06.2017 T1 Questionnaire terre-R.pdf POLIENAS (38) 10.06.2017 T2 Questionnaire terre-R.pdf",
          "text_sha256": "17e7fe9d6668b2a993c28238e75246d861224fb1b027de08b5e719a77a426108"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
