          "text": "Témoignages: LEZENNES (59) 01.01.2022",
          "text_sha256": "07eb5446ca65cd6aa3639e187ab58eaf57e028896813dd981b4bd54f46019d7a"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
