          "source_text_sha256": "fd6a0f4942e3952e85edb6bd65a6e2e4b35abf8b47128bb0fd1ca7c13ce107a2",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent and straight passage of a longitudinal light shape in the sky: very likely observation of a commercial aircraft.",
