          "source_text_sha256": "06573220a6553f84a4159f3b5f84409655e8e7610001c9f0e4c434c99dcb42c9",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage of a red cylindrical object in the sky: observation of a commercial aircraft at sunrise.",
