          "source_text_sha256": "d725983eab61e52d3d2ff37868e35c8ff56c0d31d3d7e71a8bfb6cf84c218621",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Very long, intermittent observation of a bright point in the sky that appears to be moving: observation of the star Alderaan.",
