          "source_text_sha256": "5babd95abdc4de0b2cc511db7404a775a76dc6cd8dbf47bc8bf00c5f67a8b93c",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of a straight-line passage of a PAN with colored lights, including a particularly bright white light: observation of a commercial aircraft.",
