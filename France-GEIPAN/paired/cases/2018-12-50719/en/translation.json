          "source_text_sha256": "e7b597709e82b176fb08d1c818952474ef8ba8348c4798fb2dee1246d53e6480",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: An automobilist observed the movement of several luminous objects in the night sky; very likely observation of sky lanterns.",
