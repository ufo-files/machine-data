          "source_text_sha256": "8648e7bf64f89dc64c7975f31a93493089ab64d2b3196f240a661b43445f822e",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the movements of a very bright PAN in the sky: probable observation of a Mylar-type fantasy balloon.",
