          "source_text_sha256": "d594f971ee15dcbe57bf73b2430e8d2116b872ebc0291ee2023189d7cdfed351",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of the presence at low altitude of two red and green lights adjacent with oscillating movements and a change in trajectory: probable observations of an aircraft.",
          "translation_text_sha256": "b4c8ccc0f28f43fab00fe31f3acab7d2fa1bd51d84046b367b3865c83241cf46"
        },
        {
