          "source_text_sha256": "077c1668c55e7f6941692262c3567ee8fb7d7c3716da46229c771981327967fa",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent passage of a red ball in the sky and intriguing photograph: misinterpretation of a photograph by the witness.",
