          "segment_id": "seg-f11e3a70965a9b237baa1d6f",
          "segment_index": 12,
          "source_segment_id": "seg-f11e3a70965a9b237baa1d6f",
          "source_text_sha256": "8ed4a3c4417128393cc4119d3e54d74f251cc589076332391f348dd2fe8e21c1",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the passage of two consecutive bright points: observation of the NOSS 3-8 satellite doublet.",
