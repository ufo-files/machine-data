          "text": "Témoignages: VILLEFRANCHE-SUR-MER (06) 23.07.2021",
          "text_sha256": "eea25448cadd400249a0589eb5f5b6663e0b6c8e702a1e1e9813eb17dc857bf4"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
