          "source_text_sha256": "5da8e377619b68f1f8531c8f5d410a3eb0e5ff83599a28133365b4d9976ca80f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the rapid and straight movement of a bright light point projecting bright light: probable observation of an atmospheric reentry.",
          "translation_text_sha256": "3bd19791eacb80b291ab42084e69a066f4cb40e50fa8babc71596b9925c32f82"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-22c687edc36dc30333656f9f",
          "qa_findings": [],
          "review_status": "machine-unreviewed",
          "segment_id": "seg-86a18c06ef408af4fd70a9a9",
          "segment_index": 12,
          "source_segment_id": "seg-86a18c06ef408af4fd70a9a9",
          "source_text_sha256": "3f6ad016062c1f7977800cba20cfb5415fa4821620495562264cdafb3646fd1c",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Description: The witness observes a large, bright light in the shape of a disk, emitting very bright white light. The very fast movement follows a straight trajectory from north to south (NO-SE) at a constant altitude. The very bright disk crossing the sky in 8 to 10 seconds clearly suggests re-entry into the atmosphere of a satellite debris or, more likely, a meteoroid (meteorite). This phenomenon, called a bolide, is very spectacular. The BOAM network did not record this specific event, but reports numerous similar occurrences on the same night; this is the period of several meteor showers, in particular the Eta Aquarids, which is the most intense of this time of year. The GEIPAN classifies this case as \"B\": probable observation of a bolide, caused by atmospheric re-entry of a natural object.",
          "translation_text_sha256": "dc8d9bbadb3e58dc7df01adfd33a918dda8e9091eaaceae19a694064d53078f1"
        }
