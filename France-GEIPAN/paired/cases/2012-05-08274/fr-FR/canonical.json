          "text": "Témoignages: SAINT-JUST-EN-CHAUSSEE (60) 12.05.2012",
          "text_sha256": "5377ad7985124ea450fd645e2dcbad9b6d45c29dbbdd5d8e00061da1ec44177b"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
