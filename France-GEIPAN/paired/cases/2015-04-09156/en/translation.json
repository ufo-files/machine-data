          "segment_index": 12,
          "source_segment_id": "seg-356c6f15ef73389f34d23655",
          "source_text_sha256": "2318881bc4c2df41e4eaad380b9068e8f1c2d31fe941a89fab93fcbc3e3b2c94",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the rapid passage of two blinking white light points in the sky: probable observation of two planes.",
