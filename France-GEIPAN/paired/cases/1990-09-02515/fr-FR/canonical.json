          "start_ms": null,
          "text": "Résumé: Observation du passage d'un objet rond de grandes dimensions.",
          "text_sha256": "8ac0c5fe52b4756a1b143060f115f25ca1c85dfec641120232bd564fb332cc9b"
        },
        {
          "end_ms": null,
