          "start_ms": null,
          "text": "Témoignages: ALBON (26) 25.05.2017",
          "text_sha256": "2dc1ee93d3db25659c7c38d520aaca544cac01b676d2ef534ef35241e2bcc610"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
