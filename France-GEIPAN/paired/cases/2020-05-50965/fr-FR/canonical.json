          "start_ms": null,
          "text": "Témoignages: CHARTEVES (02) 20.05.2020 T1 Questionnaire terre-R.pdf PV n°888 (2020150729).pdf CHARTEVES (02) 20.05.2020 T2 Questionnaire terre-R.pdf",
          "text_sha256": "8427d23e0d53476ba54343650a8745bfaf0a3cc7c7096380bac1750c63208e9c"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
