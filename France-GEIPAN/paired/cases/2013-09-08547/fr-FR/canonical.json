          "text": "Témoignages: SAINT-LOUBES (33) 08.09.2013",
          "text_sha256": "91ff443e65d7643f60c9ecc5df964966368c5e798e0783a84a667bf9a1caba37"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
