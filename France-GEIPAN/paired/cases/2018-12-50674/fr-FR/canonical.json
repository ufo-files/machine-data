          "text": "Témoignages: AUGEA (39) 06.12.2018",
          "text_sha256": "75ab9c645f5b7f88e149b1d46f6b9900f941a62234c3243e2b1de134ebdd8ae2"
        },
        {
          "end_ms": null,
