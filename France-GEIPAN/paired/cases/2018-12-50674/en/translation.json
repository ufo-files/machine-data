          "source_text_sha256": "bdf3436d604b3d850324f7c41720e0d20b15d390cfd0a190c1482643405f1691",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Very brief observation of the passage of a luminous phenomenon in the sky: observation of a bolide.",
