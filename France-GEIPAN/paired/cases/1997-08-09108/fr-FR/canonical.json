          "text": "Témoignages: PORT-LA-NOUVELLE (11) --.08.1997",
          "text_sha256": "3db9968fc81b6746e70bd97f21857b1fade3c847d8415220c4e8050e2315ca54"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
