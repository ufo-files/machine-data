          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Sequential observations in September 2015 of aircraft passages preceded by light phenomena: probable observations of aircraft in military operations.",
          "translation_text_sha256": "7b4ab1832f903b95e6d2844ebff7717d1633946950d78d23d033332224367170"
        },
        {
          "end_ms": null,
          "error": null,
          "field": "description",
          "page_id": "page-7cb6dacc937472fb51c4a8a0",
          "qa_findings": [
            {
              "added_in_translation": [],
