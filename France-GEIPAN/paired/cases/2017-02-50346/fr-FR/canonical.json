          "text": "Témoignages: BEAUVOISIN (26) 06.02.2017",
          "text_sha256": "893d5a1c6695eed75ec541823738e5c198973d3ff184403df11a13651753264c"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
