          "segment_index": 11,
          "start_ms": null,
          "text": "Témoignages: TUBUAI (987) 13.06.1990 T1 TUBUAI (987) 13.06.1990 T2",
          "text_sha256": "2e579a3bb14963577d4e17d64f1e098c29ad47a24efd2e1f847777964197cf67"
        },
        {
          "end_ms": null,
