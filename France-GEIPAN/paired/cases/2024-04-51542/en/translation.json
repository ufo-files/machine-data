          "segment_index": 12,
          "source_segment_id": "seg-c7f33eb0f1c942ee29a00c6c",
          "source_text_sha256": "ded95bbfdb024941f2ffcbb3134d05dcaa1c8f129ff92f9d96288742055f0e20",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of very rapid movements in the sky of a black object: observation of a fighter plane in a phase of rapid ascent for military control.",
