          "text": "Témoignages: PLEUDIHEN-SUR-RANCE (22) 22.12.2024",
          "text_sha256": "ea7b0e6d9936b8aa0cebf116cc18b29e2907dadebc67ae34c3aa3185a2ac3b2e"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
