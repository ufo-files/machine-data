          "text": "Témoignages: SALLE (LA) (88) 07.05.2015",
          "text_sha256": "8b49a1217f6264f9a287486d92cf02a9ccc901847ce926179986e4face865bbd"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
