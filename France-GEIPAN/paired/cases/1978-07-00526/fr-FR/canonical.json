          },
          "ocr_confidence": null,
          "page_id": "page-3682baa5a860386843ce08d9",
          "segment_id": "seg-c0676791e3217696f621e35c",
          "segment_index": 11,
          "start_ms": null,
          "text": "Description: Le 8 juillet 1978 vers 23h40 un témoin observe le passage N-S d' un objet volant allongé. Situé environ entre 1000 et 2000 m d'altitude par le témoin, il est composé d'un ensemble de quatre boules rouges non rayonnantes. Aucun bruit n'est entendu lors de l'observation de courte durée. Aucun autre témoignage n'a été recueilli sur ce cas pour lequel nous manquons d'informations.",
          "text_sha256": "95cb9d6c8faad81692d24458f613caa5e614aaf1b9ac80a6e1c8424a88879bca"
        }
