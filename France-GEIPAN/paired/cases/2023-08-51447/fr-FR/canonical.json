          "text": "Témoignages: BREZOLLES (28) 27.05.2023",
          "text_sha256": "58c312c29989068064f5e8fad989e0a1a9d06caccbbbd22f05a87fda4e16c850"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
            "method": "stopword-heuristic/v1"
          },
          "ocr_confidence": null,
