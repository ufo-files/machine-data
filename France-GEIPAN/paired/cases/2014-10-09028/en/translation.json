          "source_text_sha256": "81b7c5150336305879f41e362bede8ad5bfbc7891f7d63a7f598b6bdfc8a6a5a",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation of the silent movement of three red spheres on a straight trajectory then forming a triangle in a clear sky: Insufficient information.",
