          "text": "Témoignages: ORLEANS (45) 19.10.2014",
          "text_sha256": "19c22cbce8a0d9ea26dd108df89ed73a20477c27c6f3ce9e8d8a44a6e1617d3e"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
