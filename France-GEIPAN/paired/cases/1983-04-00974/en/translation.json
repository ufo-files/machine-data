          "source_text_sha256": "064afbfc7e4e6b9a5405dc1880f9432c76be1aff075dc398113eaa23b015cc64",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observations of a changing light phenomenon with a bright orange color that seemed to follow witnesses as they moved: observations of the Rusty Moon.",
          "translation_text_sha256": "5d28ae511253d9125305798b36e34602787fc94b84986ce0b8b892e52364547c"
        },
        {
          "end_ms": null,
