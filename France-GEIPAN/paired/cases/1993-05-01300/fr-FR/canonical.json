          "start_ms": null,
          "text": "Résumé: Observation de plusieurs boules lumineuses de la taille d'une étoile.",
          "text_sha256": "569db4a37852b25fdae17e524fd11cd6bb506d95fa2dd6534ee84bcb9a442b0a"
        },
        {
          "end_ms": null,
          "field": "description",
          "field_label": "Description",
          "language": {
            "code": "fr-FR",
            "confidence": 0.92,
