          "segment_index": 12,
          "source_segment_id": "seg-f0caaa729f1d40b184dd0aeb",
          "source_text_sha256": "b662dddad798c16b2aaa398a6614f8fb8586e68f3591c24bdf1a705aaa3933b4",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation in the sky of rapid movements of mobile white beams: probable observation of light displays of skyrose or bright spots.",
