          "text": "Témoignages: SAINT-PRIX (03) 31.01.2016",
          "text_sha256": "c3f4ad372ecc996b5a013cf1cc50f7090e057b4ccbe7441826e2a4d130b15581"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
