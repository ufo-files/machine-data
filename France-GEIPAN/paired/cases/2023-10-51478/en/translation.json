          "source_text_sha256": "f1745f24261bc8df22ea645f99d4e326eed9660f5b6dd0ee562797424cf5b77c",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Nighttime observation of white glowing points in motion across the sky: observation of 4 fighter jets.",
