          "source_text_sha256": "c8a3eee7ae710da669e7d3684f2201a44796f630d4e74b789c2331e7b572085f",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Observation and photographs of red lights moving quickly in the sky: likely misidentification with flare rockets.",
