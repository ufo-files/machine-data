          "source_text_sha256": "4bce4961d4edcf32d99f6ad62ac0edd48e2f4239b4d263eb2b07608d0df0e6a1",
          "start_ms": null,
          "status": "machine-unreviewed",
          "text": "Summary: Very brief observation of the rapid passage of a luminous phenomenon in the night sky: observation of a meteor.",
