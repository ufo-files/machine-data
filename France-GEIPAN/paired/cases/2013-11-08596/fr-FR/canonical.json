          "text": "Témoignages: SAINT-BENOIT-DES-ONDES (35) 03.11.2013",
          "text_sha256": "6fe333b672ac6227bebeb03adb25dbb5a7d356b795212bdab671ac3340df2820"
        },
        {
          "end_ms": null,
          "field": "summary",
          "field_label": "Résumé",
          "language": {
            "code": "fr-FR",
            "confidence": 0.99,
