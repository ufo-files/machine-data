          "text": "Témoignages: BERTIGNAT (63) 03.07.2014",
          "text_sha256": "af63dea230853c9bbc3b6d2b81537c90d5773f78e93e0b454ba21d3f4bb5f7fe"
        },
        {
          "end_ms": null,
